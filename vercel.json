{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.lujogas.com.co"
        }
      ],
      "destination": "https://lujogas.com.co/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.lujogas.com.co"
        }
      ],
      "destination": "https://lujogas.com.co/:path*",
      "permanent": true
    },
    {
      "source": "/og-image.jpg",
      "destination": "https://res.cloudinary.com/dxcbyed7d/image/upload/w_1200,h_630,c_fill,g_auto/v1781108208/lucho_ljvjfy.jpg",
      "permanent": true
    },
    {
      "source": "/blog/cada-cuanto-revisar-instalacion-gas-casa",
      "destination": "/blog/revision-periodica-gas-epm",
      "permanent": true
    },
    {
      "source": "/blog/como-saber-si-rpo-vencida-consultar",
      "destination": "/blog/revision-periodica-gas-epm",
      "permanent": true
    },
    {
      "source": "/blog/rpo-gas-revision-periodica-obligatoria-colombia",
      "destination": "/blog/revision-periodica-gas-epm",
      "permanent": true
    },
    {
      "source": "/blog/instalacion-gas-apartamento-vs-casa-diferencias",
      "destination": "/blog/instalacion-red-gas-domiciliaria",
      "permanent": true
    },
    {
      "source": "/blog/instalacion-gas-residencial-comercial-medellin",
      "destination": "/blog/instalacion-red-gas-domiciliaria",
      "permanent": true
    },
    {
      "source": "/instalacion-gas-:zona(el-poblado|laureles|envigado|bello|itagui|sabaneta|robledo|la-estrella|copacabana|belen|medellin)&:rest(.*)",
      "destination": "/instalacion-gas-:zona",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
