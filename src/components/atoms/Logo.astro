---
interface Props {
  class?: string;
  height?: number;
}
const { class: className = '', height = 70 } = Astro.props;
---

<a
  href="/"
  class:list={['inline-flex items-center', className]}
  aria-label="LujoGas — Ir al inicio"
>
  <img
    src="https://res.cloudinary.com/dx9vtev71/image/upload/e_background_removal/q_auto/f_auto/v1776525850/logo-lujoGas_hoc8ga.png"
    alt="LujoGas"
    height={height}
    style={`height: ${height}px; width: auto;`}
    loading="eager"
    decoding="async"
  />
</a>
