---
interface Props {
  num: string;
  title: string;
  description: string;
  icon: string;
}
const { num, title, description, icon } = Astro.props;
---

<article class="group relative bg-surface border border-neutral/60 rounded-2xl p-7 overflow-hidden transition-all duration-300 hover:-translate-y-1 hover:border-secondary/45 hover:shadow-[0_12px_40px_-10px_theme(colors.secondary/15%)]">
  <!-- Hover overlay -->
  <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_0%,theme(colors.secondary/5%),transparent_50%)] opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none rounded-2xl"></div>

  <!-- Icon -->
  <div
    class="relative z-10 w-12 h-12 rounded-xl grid place-items-center bg-tertiary/[0.08] border border-tertiary/20 text-tertiary transition-all duration-300 group-hover:text-secondary group-hover:bg-secondary/[0.08] group-hover:border-secondary/30"
    set:html={icon}
    aria-hidden="true"
  ></div>

  <!-- Number -->
  <span class="absolute top-[22px] right-6 font-mono font-semibold text-[13px] text-neutral tracking-[0.15em] z-10">
    {num}
  </span>

  <!-- Content -->
  <h3 class="relative z-10 font-display font-semibold text-[22px] tracking-[0.01em] text-primary mt-[22px]">
    {title}
  </h3>
  <p class="relative z-10 text-muted mt-[10px] text-[15px] leading-relaxed">
    {description}
  </p>
</article>
