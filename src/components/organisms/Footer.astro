---
import Logo from '../atoms/Logo.astro';
import { SITE, WHATSAPP_NUMBER } from '../../lib/constants';

const serviceLinks = [
  { label: 'Instalación de gas en Medellín',   href: '/instalacion-gas-medellin'     },
  { label: 'Certificación de gas en Medellín', href: '/certificacion-gas-medellin'   },
  { label: 'RPO en Medellín',                  href: '/rpo-gas-medellin'             },
  { label: 'Mantenimiento de gas en Medellín', href: '/mantenimiento-gas-medellin'   },
  { label: 'Calentadores a gas',               href: '/servicios#venta-calentadores' },
  { label: 'Blog de gas en Medellín',          href: '/blog'                         },
];

const zonaLinks = [
  { label: 'Gas en El Poblado',  href: '/instalacion-gas-el-poblado' },
  { label: 'Gas en Laureles',    href: '/instalacion-gas-laureles'   },
  { label: 'Gas en Envigado',    href: '/instalacion-gas-envigado'   },
  { label: 'Gas en Itagüí',      href: '/instalacion-gas-itagui'    },
  { label: 'Gas en Sabaneta',    href: '/instalacion-gas-sabaneta'   },
];
---

<footer class="bg-primary text-background border-t border-neutral/[12%] pt-14 pb-10" aria-label="Pie de página">
  <div class="container-section">

    <!-- ── Logo + descripción ── -->
    <div class="mb-10">
      <Logo />
      <p class="text-neutral/60 mt-4 max-w-[38ch] text-[14px] leading-relaxed">
        Técnico certificado en instalación y certificación de redes de gas en Medellín y el Valle de Aburrá. NTC 2505 · ICONTEC.
      </p>
    </div>

    <!-- Pipe separator -->
    <div
      class="h-3 mb-10 relative bg-[linear-gradient(180deg,transparent_4px,theme(colors.neutral/18%)_4px,theme(colors.neutral/18%)_8px,transparent_8px)]"
      aria-hidden="true"
    >
      <span class="absolute top-[2px] left-0 w-[14px] h-2 bg-neutral/30 rounded-[2px]"></span>
      <span class="absolute top-[2px] right-0 w-[14px] h-2 bg-neutral/30 rounded-[2px]"></span>
    </div>

    <!-- ── Link columns ── -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-8 gap-y-10">

      <!-- Servicios — links reales a /servicios#slug -->
      <div>
        <h4 class="font-display text-[13px] tracking-[0.22em] uppercase text-background mb-4">Servicios</h4>
        <ul class="flex flex-col gap-[9px] list-none p-0">
          {serviceLinks.map(item => (
            <li>
              <a
                href={item.href}
                class="text-neutral/60 text-[13.5px] transition-all duration-200 hover:text-tertiary hover:translate-x-[3px] inline-block"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Cobertura — links a páginas programáticas (internal linking SEO) -->
      <div>
        <h4 class="font-display text-[13px] tracking-[0.22em] uppercase text-background mb-4">Cobertura</h4>
        <ul class="flex flex-col gap-[9px] list-none p-0">
          {zonaLinks.map(item => (
            <li>
              <a
                href={item.href}
                class="text-neutral/60 text-[13.5px] transition-all duration-200 hover:text-tertiary hover:translate-x-[3px] inline-block"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Empresa -->
      <div>
        <h4 class="font-display text-[13px] tracking-[0.22em] uppercase text-background mb-4">Empresa</h4>
        <ul class="flex flex-col gap-[9px] list-none p-0">
          <li>
            <a href="/" class="text-neutral/60 text-[13.5px] transition-all duration-200 hover:text-tertiary hover:translate-x-[3px] inline-block">
              Inicio
            </a>
          </li>
          <li>
            <a href="/nosotros" class="text-neutral/60 text-[13.5px] transition-all duration-200 hover:text-tertiary hover:translate-x-[3px] inline-block">
              Nosotros
            </a>
          </li>
          <li>
            <a href="/servicios" class="text-neutral/60 text-[13.5px] transition-all duration-200 hover:text-tertiary hover:translate-x-[3px] inline-block">
              Servicios
            </a>
          </li>
        </ul>
      </div>

      <!-- Contacto — NAP (Name, Address, Phone) — crítico para SEO local -->
      <div class="col-span-2 md:col-span-1">
        <h4 class="font-display text-[13px] tracking-[0.22em] uppercase text-background mb-4">Contacto</h4>
        <address class="not-italic">
          <ul class="flex flex-col gap-[9px] list-none p-0">
            <li>
              <a href={`tel:${SITE.phone}`} class="text-neutral/60 text-[13.5px] transition-all duration-200 hover:text-tertiary hover:translate-x-[3px] inline-block">
                {SITE.phone.replace('+57', '').replace(/(\d{3})(\d{3})(\d{4})/, '$1 $2 $3')}
              </a>
            </li>
            <li>
              <a href={`https://wa.me/${WHATSAPP_NUMBER}`} target="_blank" rel="noopener" class="text-neutral/60 text-[13.5px] transition-all duration-200 hover:text-tertiary hover:translate-x-[3px] inline-block">
                WhatsApp directo
              </a>
            </li>
            <li class="text-neutral/60 text-[13.5px]">{SITE.address}, {SITE.city}</li>
            <li class="text-neutral/60 text-[13.5px]">{SITE.schedule}</li>
          </ul>
        </address>
      </div>
    </div>

    <!-- Legal -->
    <div class="mt-10 pt-6 border-t border-neutral/10 flex flex-col sm:flex-row sm:justify-between gap-2 text-neutral/45 text-[12px]">
      <span>© 2026 LujoGas — Todos los derechos reservados.</span>
      <span>Medellín, Antioquia · Colombia</span>
    </div>

  </div>
</footer>
