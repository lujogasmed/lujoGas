---
import { WHATSAPP_URL } from '../../lib/constants';

const VIDEO_URL =
  'https://res.cloudinary.com/dx9vtev71/video/upload/q_auto/f_auto/v1776524902/there_is_a_202604181007_1_mpzjwj.mp4';
const WA_URL = `${WHATSAPP_URL}&text=Hola%20LujoGas%2C%20necesito%20una%20cotizaci%C3%B3n`;

const stats = [
  { val: '+500', label: 'Instalaciones' },
  { val: '+3', label: 'Años de\nexperiencia' },
  { val: '100%', label: 'Certificación\nICONTEC' },
];

const anim =
  'opacity-0 animate-h-enter motion-reduce:animate-none motion-reduce:opacity-100';
---

<section
  class="relative min-h-screen overflow-hidden flex items-center bg-[#060A0D] text-hero-text"
  aria-label="LujoGas — Instalación de gas en Medellín"
>
  <!-- ════ VIDEO PANEL ════ -->
  <div
    class="absolute inset-0 w-full h-full pointer-events-none lg:left-auto lg:w-[58%]"
    aria-hidden="true"
  >
    <video
      autoplay
      muted
      loop
      playsinline
      disablepictureinpicture
      preload="metadata"
      poster="https://res.cloudinary.com/dx9vtev71/video/upload/so_0,q_auto,f_jpg/v1776524902/there_is_a_202604181007_1_mpzjwj.jpg"
      class="absolute right-0 top-0 w-full h-full object-cover object-center opacity-25 lg:opacity-[0.88]"
    >
      <source src={VIDEO_URL} type="video/mp4" />
    </video>

    <!-- Fade izquierdo (5 stops) -->
    <div
      class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_right,theme(colors.hero-bg)_0%,theme(colors.hero-bg/96%)_20%,theme(colors.hero-bg/65%)_45%,theme(colors.hero-bg/10%)_72%,transparent_100%)]"
    >
    </div>
    <!-- Fade top -->
    <div
      class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_bottom,theme(colors.hero-bg)_0%,theme(colors.hero-bg/70%)_18%,transparent_42%)]"
    >
    </div>
    <!-- Fade bottom -->
    <div
      class="absolute inset-0 pointer-events-none bg-[linear-gradient(to_top,theme(colors.hero-bg)_0%,theme(colors.hero-bg/55%)_20%,transparent_44%)]"
    >
    </div>
  </div>

  <!-- Subtle grid overlay (utility compartida por ser mask-image complejo) -->
  <div class="pipes-bg" aria-hidden="true"></div>

  <!-- ════ CONTENT ════ -->
  <div
    class="container-section relative z-10 w-full flex items-center min-h-screen pt-[130px] pb-[60px]"
  >
    <div class="w-full max-w-[560px]">
      <!-- Eyebrow -->
      <div class={`${anim} [animation-delay:0.08s]`}>
        <div class="flex items-center gap-3 mb-8">
          <span class="block w-8 h-[1.5px] bg-blue-base flex-shrink-0"></span>
          <span
            class="font-mono text-[10px] font-bold tracking-[3.5px] uppercase text-hero-muted"
          >
            Medellín · Antioquia · Colombia
          </span>
        </div>
      </div>

      <!-- Headline -->
      <h1
        class={`${anim} [animation-delay:0.20s] font-display text-[clamp(60px,7.5vw,112px)] leading-[0.95] tracking-[1px] mb-8 flex flex-col`}
        aria-label="Instalación certificada de gas en Medellín"
      >
        <span class="text-hero-text">Instalación</span>
        <span class="text-blue-bright text-glow-blue">certificada</span>
        <span class="text-hero-text/30">de gas en</span>
        <span class="text-hero-text">Medellín</span>
      </h1>

      <!-- Separator -->
      <div
        class={`${anim} [animation-delay:0.32s] w-[180px] h-px mb-6 bg-gradient-to-r from-blue-base/40 to-transparent`}
        aria-hidden="true"
      >
      </div>

      <!-- Body copy -->
      <p
        class={`${anim} [animation-delay:0.42s] font-body text-[15px] font-normal leading-[1.75] text-hero-muted max-w-[360px] mb-10`}
      >
        Redes residenciales y comerciales ejecutadas por técnicos certificados.
        Diseño, instalación, pruebas hidrostáticas y certificado oficial — todo
        con una sola empresa.
      </p>

      <!-- CTAs -->
      <div class={`${anim} [animation-delay:0.52s] flex flex-wrap gap-3`}>
        <a
          href={WA_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-[15px] rounded-full text-white font-bold text-[14px] tracking-[0.02em] no-underline wa-pulse hover:-translate-y-0.5 transition-all duration-[180ms] bg-whatsapp shadow-[0_4px_28px_rgba(37,211,102,0.25)]"
          aria-label="Cotizar por WhatsApp"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
            ></path>
          </svg>
          Cotizar por WhatsApp
        </a>

        <a
          href="#servicios"
          class="inline-flex items-center gap-[7px] py-[15px] border-b border-white/[0.08] text-[rgba(232,237,245,0.65)] text-[14px] font-medium no-underline transition-[color,border-color] duration-200 hover:text-blue-bright hover:border-blue-base"
          aria-label="Ver servicios"
        >
          Ver servicios &nbsp;→
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom accent line -->
  <div
    class="absolute bottom-0 left-0 right-0 h-px bg-[linear-gradient(to_right,transparent,rgba(61,127,255,0.2)_25%,rgba(106,170,255,0.35)_50%,rgba(61,127,255,0.2)_75%,transparent)]"
    aria-hidden="true"
  >
  </div>
</section>

<!-- ════ STATS SECTION ════ -->
<section
  class="bg-hero-bg border-b border-white/[0.05]"
  aria-label="Cifras de LujoGas"
>
  <div class="container-section">
    <div class="grid grid-cols-3 divide-x divide-white/[0.05]">

      <!-- Stat 1 -->
      <div class="flex flex-col gap-1 py-5 pr-4 sm:py-8 sm:pr-10">
        <div class="font-display text-[28px] sm:text-[52px] leading-none text-hero-amber flex items-baseline gap-0.5">
          <span class="sn-val" data-target="500">0</span>
          <span class="text-[18px] sm:text-[32px]">+</span>
        </div>
        <div class="font-mono text-[8px] sm:text-[10px] font-bold tracking-[1.5px] sm:tracking-[2.5px] uppercase text-hero-muted leading-tight">
          Instalaciones
        </div>
      </div>

      <!-- Stat 2 -->
      <div class="flex flex-col gap-1 py-5 px-4 sm:py-8 sm:px-10">
        <div class="font-display text-[28px] sm:text-[52px] leading-none text-hero-amber flex items-baseline gap-0.5">
          <span class="sn-val" data-target="3">0</span>
          <span class="text-[18px] sm:text-[32px]">+</span>
        </div>
        <div class="font-mono text-[8px] sm:text-[10px] font-bold tracking-[1.5px] sm:tracking-[2.5px] uppercase text-hero-muted leading-tight">
          Años exp.
        </div>
      </div>

      <!-- Stat 3 -->
      <div class="flex flex-col gap-1 py-5 pl-4 sm:py-8 sm:pl-10">
        <div class="font-display text-[28px] sm:text-[52px] leading-none text-hero-amber flex items-baseline gap-0.5">
          <span class="sn-val" data-target="100">0</span>
          <span class="text-[18px] sm:text-[32px]">%</span>
        </div>
        <div
          class="font-mono text-[10px] font-bold tracking-[2.5px] uppercase text-hero-muted"
        >
          Certificación
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  // Count-up animation on viewport entry
  function countUp(el, target, duration) {
    var start = performance.now();
    function tick(now) {
      var t = Math.min((now - start) / duration, 1);
      var ease = 1 - Math.pow(1 - t, 4);
      el.textContent = Math.round(ease * target);
      if (t < 1) requestAnimationFrame(tick);
      else el.textContent = target;
    }
    requestAnimationFrame(tick);
  }

  var statsSection = document.querySelector('[aria-label="Cifras de LujoGas"]');
  if (statsSection) {
    var obs = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            statsSection.querySelectorAll('.sn-val').forEach(function (el) {
              countUp(el, +el.dataset.target, 1800);
            });
            obs.disconnect();
          }
        });
      },
      { threshold: 0.3 },
    );
    obs.observe(statsSection);
  }
</script>
