---

<section class="bg-white relative overflow-hidden pb-14" id="confianza" aria-labelledby="confianza-heading">

  <!-- Subtle grid bg -->
  <div class="pipes-bg" aria-hidden="true"></div>

  <div class="container-section relative z-10">

    <!-- Header -->
    <div class="flex items-end justify-between gap-6 mb-16 flex-wrap reveal">
      <div>
        <EyebrowLabel text="Confianza · 02" />
        <h2 id="confianza-heading" class="font-display font-semibold tracking-[0.01em] leading-[1.02] mt-3 text-[clamp(34px,4.4vw,54px)] text-primary">
          Certificados, medibles,<br />verificables.
        </h2>
      </div>
      <p class="text-muted max-w-[44ch] text-[16px] leading-relaxed">
        Cada instalación queda documentada, probada y certificada bajo normas técnicas colombianas. Transparencia total.
      </p>
    </div>

    <!-- Stats -->
    <!-- <div class="grid grid-cols-2 md:grid-cols-4 reveal-stagger mb-14">
      {stats.map((s, i) => (
        <StatCounter value={s.value} suffix={s.suffix} label={s.label} />
      ))}
    </div> -->

    <!-- Badge cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 reveal-stagger">
      {badges.map((b) => (
        <div class="group relative bg-background border border-neutral/20 rounded-2xl p-6 flex flex-col gap-4 hover:border-tertiary/30 hover:shadow-[0_4px_20px_-6px_theme(colors.primary/8%)] transition-all duration-300 overflow-hidden">
          <!-- accent line top -->
          <div class="absolute top-0 left-6 right-6 h-[1px] bg-gradient-to-r from-transparent via-tertiary/40 to-transparent"></div>
          <!-- Icon -->
          <div class="w-11 h-11 rounded-xl bg-tertiary/10 border border-tertiary/20 text-tertiary flex items-center justify-center group-hover:bg-tertiary/20 group-hover:border-tertiary/40 transition-all duration-300">
            <span class="w-5 h-5 block" set:html={b.icon} />
          </div>
          <!-- Text -->
          <div>
            <div class="font-display text-[16px] tracking-[0.04em] text-primary font-semibold leading-snug">{b.title}</div>
            <div class="text-muted text-[12.5px] tracking-[0.03em] mt-[5px]">{b.subtitle}</div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script is:inline>
  const counterIo = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      const el = e.target;
      const target = +el.dataset.count;
      const nEl = el.querySelector('.n');
      const dur = 1500;
      const start = performance.now();
      const tick = (t) => {
        const p = Math.min(1, (t - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        nEl.textContent = Math.round(target * eased);
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
      counterIo.unobserve(el);
    });
  }, { threshold: 0.4 });

  document.querySelectorAll('.stat .val').forEach((el) => counterIo.observe(el));
</script>
