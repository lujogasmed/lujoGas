---
import '../styles/global.css';
import { SITE } from '../lib/constants';
import { localBusinessSchema } from '../lib/schema';
import GeoMeta from '../components/atoms/GeoMeta.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  ogType?: string;
}

const {
  title = 'Instalación de Gas en Medellín Certificada | LujoGas',
  description = SITE.description,
  canonical = Astro.site?.toString() ?? 'https://lujogas.com.co/',
  ogImage = 'https://res.cloudinary.com/dxcbyed7d/image/upload/w_1200,h_630,c_fill,g_auto/v1781108208/lucho_ljvjfy.jpg',
  noindex = false,
  ogType = 'website',
} = Astro.props;

const ogImageAbsolute = ogImage.startsWith('http') ? ogImage : `https://lujogas.com.co${ogImage}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO primary -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />

    <!-- Theme color -->
    <meta name="theme-color" content="#0D0D0D" />

    <!-- hreflang — es-CO -->
    <link rel="alternate" hreflang="es-CO" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="LujoGas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="LujoGas — Instalación certificada de gas en Medellín" />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    <meta name="twitter:image:alt" content="LujoGas — Instalación certificada de gas en Medellín" />

    <!-- Geo meta tags — local SEO crítico -->
    <GeoMeta />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- GA4 preconnect -->
    <link rel="preconnect" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://www.google-analytics.com" />

    <!-- Google Fonts — preload critical weights -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Rajdhani:wght@500;600;700&display=swap"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <!-- JSON-LD LocalBusiness Schema -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />

    <!-- Google Analytics 4 -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}></script>
    <script define:vars={{ ga4Id: SITE.ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', ga4Id);

      // Conversiones: clic en WhatsApp (whatsapp_click) y llamada (phone_click).
      // Delegado en document para cubrir todos los CTAs, incluido el flotante React.
      document.addEventListener('click', function (e) {
        var link = e.target instanceof Element ? e.target.closest('a[href]') : null;
        if (!link) return;
        var href = link.getAttribute('href') || '';
        var isWa = /wa\.me|api\.whatsapp\.com/.test(href);
        var isTel = href.indexOf('tel:') === 0;
        if (!isWa && !isTel) return;
        var section = link.closest('[data-gtm-source]');
        var source =
          (section && section.getAttribute('data-gtm-source')) ||
          (link.id === 'floatWp' && 'flotante') ||
          (link.closest('header') && 'header') ||
          (link.closest('footer') && 'footer') ||
          ((section = link.closest('section[id]')) && section.id) ||
          'contenido';
        gtag('event', isWa ? 'whatsapp_click' : 'phone_click', {
          link_source: source,
          link_text: (link.textContent || link.getAttribute('aria-label') || '').trim().slice(0, 80),
          page_path: location.pathname,
        });
      });
    </script>
  </head>

  <body>
    <!-- GTM Body — TODO: reemplazar GTM-XXXXXXX con ID real -->
    <!-- <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-XXXXXXX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript> -->

    <slot />
  </body>
</html>
