        <div class="mt-6 text-center reveal">
          <a href="/certificacion-gas-medellin" class="text-[14px] font-semibold underline underline-offset-2 hover:opacity-75 transition-opacity" style="color:#2563EB;">
            Ver servicio de certificación de gas en Medellín →
