        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 reveal-stagger">
          {materiales.map((m) => (
            <div class="flex gap-5 p-6 bg-surface border border-neutral/15 rounded-2xl hover:border-tertiary/25 transition-colors duration-200">
              <div class="w-10 h-10 rounded-lg flex-shrink-0 flex items-center justify-center mt-0.5" style="background:rgba(37,99,235,0.08); color:#2563EB;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 12h6m6 0h6M9 6v12M15 6v12"/><circle cx="12" cy="12" r="2.2"/></svg>
              </div>
              <div>
                <h3 class="font-display font-semibold text-primary text-[16px] mb-2 leading-snug">{m.title}</h3>
                <p class="text-muted text-[13.5px] leading-relaxed">{m.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Zonas de cobertura ─────────────────────────────────────────────── -->
    <section class="section-pad" style="background:#F8F7F4;" aria-labelledby="cobertura-medellin-heading">
      <div class="container-section">
        <div class="text-center mb-10 reveal">
          <EyebrowLabel text="Cobertura" />
          <h2 id="cobertura-medellin-heading" class="font-display font-semibold text-primary mt-3 leading-tight" style="font-size:clamp(26px,3vw,42px);">
            Instalación de gas en toda el área metropolitana de Medellín
          </h2>
          <p class="text-muted mt-3 max-w-[52ch] mx-auto text-[15px]">
            Atendemos instalaciones de gas en Medellín y todos los municipios del Valle de Aburrá. Selecciona tu zona para información específica.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 reveal-stagger">
          {zonas.map((z) => (
            <a
              href={`/instalacion-gas-${z.slug}`}
              class="group flex items-center justify-center gap-2 border border-neutral/15 rounded-xl px-4 py-3 text-[13.5px] font-semibold text-primary hover:border-tertiary/40 hover:bg-tertiary/5 transition-all duration-200 text-center min-h-[44px]"
