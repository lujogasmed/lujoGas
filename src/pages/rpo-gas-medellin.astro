---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import CTASection from '../components/organisms/CTASection.astro';
import EyebrowLabel from '../components/atoms/EyebrowLabel.astro';
import Button from '../components/atoms/Button.astro';
import WhatsAppIcon from '../components/atoms/WhatsAppIcon.astro';
import { WHATSAPP_URL } from '../lib/constants';
import { zonas } from '../data/zonas';

const canonical = 'https://lujogas.com.co/rpo-gas-medellin';

const faq = [
  {
    q: '¿Qué es la Revisión Periódica Obligatoria de gas?',
    a: 'La RPO es una inspección técnica exigida por la regulación colombiana (Resolución CREG 059 de 2012 y NTC 2505) que deben pasar todas las instalaciones de gas cada 5 años para verificar que siguen siendo seguras.',
  },
  {
    q: '¿Cada cuánto hay que hacer la RPO en Medellín?',
    a: 'Cada 5 años desde la fecha del último certificado. Puedes hacerla desde 5 meses antes del vencimiento; EPM avisa en la factura con esa anticipación y vuelve a avisar en el último mes del plazo.',
  },
  {
    q: '¿Qué pasa si no hago la RPO?',
    a: 'EPM suspende el servicio. En 2026 la suspensión cuesta $67.000 y la reconexión otros $67.000, además de la revisión pendiente. Si alguien reconecta el gas sin autorización, el cobro sube a $532.000.',
  },
  {
    q: '¿Qué revisa el técnico durante la RPO?',
    a: 'El técnico certificado NTC 2505 revisa: estado de la tubería, conexiones, válvulas, reguladores, ventilación, prueba de hermeticidad, funcionamiento de gasodomésticos y análisis de combustión.',
  },
  {
    q: '¿Cuánto vale la revisión del gas en Medellín en 2026?',
    a: 'La tarifa que publica EPM para 2026 es $151.596 con IVA en vivienda residencial y $239.363 en no residencial. Con LujoGas la RPO residencial cuesta desde $150.000, con certificado en 24 a 48 horas. Si aparecen hallazgos, la corrección se presupuesta aparte y antes de intervenir.',
  },
  {
    q: '¿Qué pasa si encuentran fallas durante la RPO?',
    a: 'Depende del tipo de defecto. Un defecto crítico (fuga, falta de ventilación con riesgo de monóxido) obliga a suspender el servicio hasta corregirlo. Uno no crítico se puede corregir dentro del plazo de la revisión sin cortar el gas. En ambos casos te entregamos el presupuesto antes de intervenir y, corregido, el certificado sale en 24-48 horas.',
  },
  {
    q: '¿Cuánto dura la visita de RPO?',
    a: 'La visita completa (inspección + pruebas) toma aproximadamente 1 hora para un apartamento estándar. Para casas grandes o instalaciones comerciales, puede tomar hasta 2-3 horas.',
  },
  {
    q: '¿Atienden RPO en todo Medellín?',
    a: 'Sí. Cubrimos todo Medellín y los municipios del Valle de Aburrá: El Poblado, Laureles, Belén, Robledo, Envigado, Bello, Itagüí, Sabaneta, La Estrella y Copacabana.',
  },
];

const rpoFaqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'LujoGas',
      item: 'https://lujogas.com.co/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'RPO Gas Medellín',
      item: canonical,
    },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Revisión Periódica Obligatoria (RPO) de Gas en Medellín',
  description:
    'Revisión Periódica Obligatoria de gas realizada por técnico certificado NTC 2505 en Medellín y el Valle de Aburrá. Certificado ICONTEC en 24-48 horas.',
  provider: { '@type': 'LocalBusiness', name: 'LujoGas' },
  areaServed: zonas.map((z) => z.name),
  serviceType: 'Revisión Periódica Obligatoria de Gas',
};
---

<BaseLayout
  title="Revisión de Gas Medellín 2026: Precio RPO y Plazos"
  description="¿Cuánto vale la revisión del gas en 2026? Tarifa EPM $151.596 y RPO con LujoGas desde $150.000 en Medellín. Certificado en 24–48 h. Evita la suspensión."
  canonical={canonical}
>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(rpoFaqSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <main>
    <!-- Hero -->
    <section
      class="relative bg-hero-bg overflow-hidden pt-[140px] pb-[80px] md:pt-[160px] md:pb-[100px]"
    >
      <div class="pipes-bg"></div>
      <div class="container-section relative z-10">
        <nav
          class="flex items-center gap-2 text-sm text-hero-text/60 mb-6"
          aria-label="Breadcrumb"
        >
          <a href="/" class="hover:text-blue-bright transition-colors">Inicio</a
          >
          <span>/</span>
          <span class="text-hero-text/40">RPO Gas Medellín</span>
        </nav>
        <EyebrowLabel text="Revisión Periódica Obligatoria" class="mb-2" />
        <h1
          class="font-display text-4xl md:text-6xl lg:text-7xl text-background leading-[0.85] tracking-[-0.02em] uppercase max-w-4xl"
        >
          Revisión Periódica Obligatoria de Gas <span class="text-tertiary"
            >en Medellín</span
          >
        </h1>
        <p
          class="text-xl md:text-2xl text-blue-bright font-display tracking-wide uppercase mt-4"
        >
          Revisión Periódica Obligatoria de gas
        </p>
        <p
          class="text-hero-text text-lg md:text-xl max-w-2xl mt-6 leading-relaxed"
        >
          La normativa colombiana exige una revisión completa de tu instalación
          de gas cada 5 años. En <strong>LujoGas</strong> realizamos la RPO con técnico
          certificado <strong>NTC 2505</strong> y emitimos el certificado <strong
            >ICONTEC</strong
          > en 24 a 48 horas en toda Medellín y el Valle de Aburrá.
        </p>
        <div class="flex flex-wrap gap-4 mt-8">
          <Button
            href={WHATSAPP_URL}
            variant="whatsapp"
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
            ariaLabel="Agendar RPO por WhatsApp"
          >
            <WhatsAppIcon />
            Agendar RPO
          </Button>
          <Button
            href="tel:+573014748653"
            variant="ghost"
            size="lg"
            ariaLabel="Llamar ahora"
          >
            Llamar ahora
          </Button>
        </div>
        <div class="flex items-center gap-6 mt-6 text-sm text-hero-text/50">
          <span>🔹 Visita $50.000</span>
          <span>🔹 Certificado en 24-48h</span>
          <span>🔹 Técnico NTC 2505</span>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="py-12 bg-hero-surface">
      <div class="container-section">
        <div
          class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center reveal-stagger"
        >
          <div>
            <p class="font-display text-3xl md:text-4xl text-tertiary">3+</p>
            <p class="text-hero-text text-sm mt-1">Años de experiencia</p>
          </div>
          <div>
            <p class="font-display text-3xl md:text-4xl text-tertiary">
              3.000+
            </p>
            <p class="text-hero-text text-sm mt-1">
              Certificaciones realizadas
            </p>
          </div>
          <div>
            <p class="font-display text-3xl md:text-4xl text-tertiary">10</p>
            <p class="text-hero-text text-sm mt-1">Municipios cubiertos</p>
          </div>
          <div>
            <p class="font-display text-3xl md:text-4xl text-tertiary">500+</p>
            <p class="text-hero-text text-sm mt-1">Instalaciones realizadas</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Precio 2026 — responde "cuánto vale la revisión del gas" -->
    <section class="section-pad bg-background" aria-labelledby="precio-rpo-heading">
      <div class="container-section max-w-[860px]">
        <EyebrowLabel text="Precio 2026" class="mb-2" />
        <h2
          id="precio-rpo-heading"
          class="font-display text-3xl md:text-4xl text-primary uppercase tracking-[-0.02em] mb-6"
        >
          ¿Cuánto vale la revisión del gas en Medellín en 2026?
        </h2>
        <p class="text-primary/80 text-lg leading-relaxed mb-6">
          La revisión periódica residencial cuesta <strong>$151.596 con IVA</strong> según la tarifa
          que publica EPM para 2026. Con <strong>LujoGas la RPO residencial cuesta desde $150.000</strong>,
          incluye prueba de hermeticidad, revisión de ventilación y medición de monóxido de carbono, y
          el certificado sale en 24 a 48 horas hábiles. La revisión se paga una vez cada 5 años.
        </p>
        <div class="overflow-x-auto rounded-2xl border border-neutral/30 bg-surface">
          <table class="w-full min-w-[520px] text-left text-[15px]">
            <caption class="sr-only">Tarifas 2026 de revisión periódica de gas publicadas por EPM</caption>
            <thead class="bg-primary text-background">
              <tr>
                <th scope="col" class="px-4 py-3 md:px-6 font-mono text-[12px] uppercase tracking-[0.14em]">Tipo de instalación</th>
                <th scope="col" class="px-4 py-3 md:px-6 font-mono text-[12px] uppercase tracking-[0.14em]">Antes de IVA</th>
                <th scope="col" class="px-4 py-3 md:px-6 font-mono text-[12px] uppercase tracking-[0.14em]">Con IVA</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral/20 text-primary/80">
              {
                [
                  ['Residencial', '$127.392', '$151.596'],
                  ['No residencial (comercio)', '$201.146', '$239.363'],
                  ['Industria pequeña (0–60 m³/h)', '$917.733', '$1.092.102'],
                  ['Industria mediana (61–200 m³/h)', '$1.376.599', '$1.638.152'],
                  ['Industria grande (más de 201 m³/h)', '$2.064.900', '$2.457.232'],
                  ['Línea matriz (por usuario)', '$15.221', '$18.112'],
                ].map(([tipo, base, iva]) => (
                  <tr>
                    <th scope="row" class="px-4 py-3 md:px-6 font-semibold text-primary">{tipo}</th>
                    <td class="px-4 py-3 md:px-6">{base}</td>
                    <td class="px-4 py-3 md:px-6 font-semibold text-primary">{iva}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-sm text-muted mt-3">
          Fuente:
          <a
            href="https://www.epm.com.co/clientesyusuarios/gas/revisiones-tecnicas-o-periodicas/"
            target="_blank"
            rel="noopener nofollow"
            class="underline underline-offset-2 hover:text-tertiary">EPM, revisiones técnicas o periódicas de gas</a
          >. Valores consultados en octubre de 2026.
        </p>

        <h3 class="font-display text-2xl text-primary uppercase tracking-[-0.01em] mt-10 mb-4">
          Lo que cuesta no hacerla a tiempo
        </h3>
        <ul class="flex flex-col gap-3 text-primary/80 text-lg leading-relaxed">
          <li><strong>Suspensión del servicio:</strong> $67.000.</li>
          <li><strong>Reconexión:</strong> $67.000, y solo después de presentar el certificado vigente.</li>
          <li><strong>Reconexión no autorizada:</strong> $532.000 si el gas se reconecta sin EPM.</li>
        </ul>
        <p class="text-primary/80 text-lg leading-relaxed mt-6">
          El plazo corre desde la fecha del último certificado: puedes hacer la revisión desde 5 meses
          antes del vencimiento. Si EPM ya te avisó en la factura, agenda con tiempo; si aparecen
          hallazgos, necesitas margen para corregirlos. El desglose de otros servicios está en
          <a
            href="/blog/cuanto-cuesta-mantenimiento-gas-medellin"
            class="text-tertiary font-semibold underline underline-offset-4 hover:opacity-80">cuánto cuesta el mantenimiento de gas</a
          > y en
          <a
            href="/blog/cuanto-cuesta-certificacion-gas-medellin"
            class="text-tertiary font-semibold underline underline-offset-4 hover:opacity-80">cuánto cuesta la certificación de gas</a
          >.
        </p>
      </div>
    </section>

    <!-- What is RPO -->
    <section class="section-pad">
      <div class="container-section max-w-[800px]">
        <EyebrowLabel text="¿Qué es la RPO?" class="mb-2" />
        <h2
          class="font-display text-3xl md:text-4xl text-primary uppercase tracking-[-0.02em] mb-6"
        >
          Revisión Periódica Obligatoria de gas
        </h2>
        <p class="text-primary/80 text-lg leading-relaxed mb-5">
          La <strong>Revisión Periódica Obligatoria (RPO)</strong> es una inspección
          técnica que deben pasar todas las instalaciones de gas en Colombia cada
          5 años, según la Resolución CREG 059 de 2012 y la{
            ' '
          }
          <a
            href="/blog/ntc-2505-norma-colombiana-instalaciones-gas"
            class="text-tertiary font-semibold underline underline-offset-4 hover:opacity-80"
          >
            Norma Técnica Colombiana NTC 2505
          </a>.
        </p>
        <p class="text-primary/80 text-lg leading-relaxed mb-5">
          El objetivo de la RPO es verificar que tu instalación de gas sigue
          siendo segura con el paso del tiempo. Las tuberías se deterioran, las
          conexiones se aflojan y los gasodomésticos envejecen. Una revisión
          periódica detecta estos problemas antes de que se conviertan en
          emergencias.
        </p>
        <p class="text-primary/80 text-lg leading-relaxed">
          En <strong>LujoGas</strong>, nuestro técnico certificado NTC 2505
          realiza la inspección completa: revisa la tubería en todo su
          recorrido, las conexiones, las válvulas, los reguladores de presión,
          la ventilación de los recintos y el funcionamiento de los
          gasodomésticos. Si todo está en orden, emitimos el certificado ICONTEC
          en 24 a 48 horas.
        </p>
        <p class="text-primary/80 text-lg leading-relaxed mt-5">
          Si vives en un conjunto o edificio, ten en cuenta que la RPO de tu
          apartamento no cubre la tubería de las zonas comunes. Esa es la línea
          matriz, también se revisa cada 5 años y la contrata la administración:
          lo explicamos en
          <a
            href="/certificacion-linea-matriz-gas-medellin"
            class="text-tertiary font-semibold underline underline-offset-4 hover:opacity-80"
          >
            certificación de línea matriz de gas
          </a>.
        </p>
      </div>
    </section>

    <!-- Checklist -->
    <section class="section-pad bg-surface">
      <div class="container-section">
        <div class="max-w-[800px] mx-auto">
          <EyebrowLabel text="¿Qué revisamos?" class="mb-2" />
          <h2
            class="font-display text-3xl md:text-4xl text-primary uppercase tracking-[-0.02em] mb-8"
          >
            Nuestro proceso de <span class="text-tertiary">inspección RPO</span>
          </h2>
        </div>
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-[1000px] mx-auto"
        >
          <div class="bg-background rounded-xl p-6 border border-neutral/10">
            <span class="font-display text-2xl text-tertiary">01</span>
            <h3 class="font-display text-lg text-primary uppercase mt-2">
              Inspección visual
            </h3>
            <p class="text-muted text-sm mt-2">
              Revisamos el estado general de la tubería, conexiones, válvulas y
              reguladores buscando corrosión, golpes o desgaste.
            </p>
          </div>
          <div class="bg-background rounded-xl p-6 border border-neutral/10">
            <span class="font-display text-2xl text-tertiary">02</span>
            <h3 class="font-display text-lg text-primary uppercase mt-2">
              Prueba de hermeticidad
            </h3>
            <p class="text-muted text-sm mt-2">
              Presurizamos la red con aire comprimido y verificamos que no haya
              pérdida de presión. Es la prueba más importante para descartar
              fugas.
            </p>
          </div>
          <div class="bg-background rounded-xl p-6 border border-neutral/10">
            <span class="font-display text-2xl text-tertiary">03</span>
            <h3 class="font-display text-lg text-primary uppercase mt-2">
              Verificación de ventilación
            </h3>
            <p class="text-muted text-sm mt-2">
              Medimos que los recintos con gasodomésticos tengan la ventilación
              adecuada para evitar acumulación de monóxido de carbono.
            </p>
          </div>
          <div class="bg-background rounded-xl p-6 border border-neutral/10">
            <span class="font-display text-2xl text-tertiary">04</span>
            <h3 class="font-display text-lg text-primary uppercase mt-2">
              Revisión de gasodomésticos
            </h3>
            <p class="text-muted text-sm mt-2">
              Verificamos que estufas, calentadores, hornos y secadoras estén
              correctamente conectados y funcionando sin fugas.
            </p>
          </div>
          <div class="bg-background rounded-xl p-6 border border-neutral/10">
            <span class="font-display text-2xl text-tertiary">05</span>
            <h3 class="font-display text-lg text-primary uppercase mt-2">
              Análisis de combustión
            </h3>
            <p class="text-muted text-sm mt-2">
              Medimos la calidad de la combustión y las emisiones para
              garantizar que los equipos quemen gas de forma eficiente y segura.
            </p>
          </div>
          <div class="bg-background rounded-xl p-6 border border-neutral/10">
            <span class="font-display text-2xl text-tertiary">06</span>
            <h3 class="font-display text-lg text-primary uppercase mt-2">
              Certificado ICONTEC
            </h3>
            <p class="text-muted text-sm mt-2">
              Si todo está en orden, emitimos el certificado ICONTEC oficial y
              lo enviamos en formato digital y físico en 24 a 48 horas.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Why choose us -->
    <section class="section-pad">
      <div class="container-section max-w-[800px]">
        <EyebrowLabel text="¿Por qué LujoGas?" class="mb-2" />
        <h2
          class="font-display text-3xl md:text-4xl text-primary uppercase tracking-[-0.02em] mb-8"
        >
          Tu RPO con <span class="text-tertiary">tranquilidad</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="flex gap-4">
            <span class="text-tertiary text-xl flex-shrink-0">✓</span>
            <div>
              <h3 class="font-display text-lg text-primary uppercase">
                Técnico certificado NTC 2505
              </h3>
              <p class="text-muted text-sm mt-1">
                Luis Guillermo Muñoz Vélez, técnico certificado con aval
                ICONTEC.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="text-tertiary text-xl flex-shrink-0">✓</span>
            <div>
              <h3 class="font-display text-lg text-primary uppercase">
                Certificado en 24-48 horas
              </h3>
              <p class="text-muted text-sm mt-1">
                Recibes tu certificado ICONTEC en formato digital al día
                siguiente hábil.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="text-tertiary text-xl flex-shrink-0">✓</span>
            <div>
              <h3 class="font-display text-lg text-primary uppercase">
                Corrección de fallas incluida
              </h3>
              <p class="text-muted text-sm mt-1">
                Si encontramos problemas, los corregimos para que obtengas tu
                certificado.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="text-tertiary text-xl flex-shrink-0">✓</span>
            <div>
              <h3 class="font-display text-lg text-primary uppercase">
                Materiales certificados
              </h3>
              <p class="text-muted text-sm mt-1">
                Usamos exclusivamente materiales con sello NTC 2505. Sin atajos.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="text-tertiary text-xl flex-shrink-0">✓</span>
            <div>
              <h3 class="font-display text-lg text-primary uppercase">
                Experiencia local
              </h3>
              <p class="text-muted text-sm mt-1">
                Más de 3.000 certificaciones realizadas en Medellín y el Valle
                de Aburrá.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <span class="text-tertiary text-xl flex-shrink-0">✓</span>
            <div>
              <h3 class="font-display text-lg text-primary uppercase">
                Sin intermediarios
              </h3>
              <p class="text-muted text-sm mt-1">
                El técnico que hace la visita es el mismo que certifica.
                Atención directa y personalizada.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Coverage -->
    <section class="section-pad bg-surface">
      <div class="container-section">
        <EyebrowLabel text="Cobertura" class="mb-2" />
        <h2
          class="font-display text-3xl md:text-4xl text-primary uppercase tracking-[-0.02em] mb-4"
        >
          RPO en todo <span class="text-tertiary">Medellín</span> y el Valle de Aburrá
        </h2>
        <p class="text-muted text-lg max-w-2xl mb-10">
          Realizamos la Revisión Periódica Obligatoria en los principales
          municipios y barrios del área metropolitana.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3">
          {
            zonas.map((zona) => (
              <a
                href={`/instalacion-gas-${zona.slug}`}
                class="block bg-background rounded-xl p-4 text-center border border-neutral/10 hover:border-tertiary/30 hover:-translate-y-0.5 transition-all duration-200"
              >
                <span class="font-display text-lg text-primary uppercase">
                  {zona.name}
                </span>
                <span class="block text-xs text-muted mt-1 capitalize">
                  {zona.tipo}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section-pad" id="faq">
      <div class="container-section max-w-[800px]">
        <EyebrowLabel text="Preguntas frecuentes" class="mb-2" />
        <h2
          class="font-display text-3xl md:text-4xl text-primary uppercase tracking-[-0.02em] mb-8"
        >
          Todo lo que necesitas <span class="text-tertiary">saber</span>
        </h2>
        <div class="space-y-3">
          {
            faq.map((item) => (
              <details class="group bg-surface rounded-xl border border-neutral/10 overflow-hidden">
                <summary class="cursor-pointer font-display text-lg text-primary uppercase p-5 pr-12 relative hover:text-tertiary transition-colors list-none [&::-webkit-details-marker]:hidden">
                  {item.q}
                  <span class="absolute right-5 top-5 text-tertiary transition-transform duration-300 group-open:rotate-45 text-xl">
                    +
                  </span>
                </summary>
                <div class="px-5 pb-5">
                  <p class="text-primary/80 leading-relaxed">{item.a}</p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />

  <script is:inline>
    const io = new IntersectionObserver(
      (entries) => { entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); },
      { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => io.observe(el));
  </script>
  <script>
    // FAQ accordion keyboard accessibility
    document.querySelectorAll('details summary').forEach((summary) => {
      summary.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const details = summary.closest('details');
          details.open = !details.open;
        }
      });
    });
  </script>
</BaseLayout>
