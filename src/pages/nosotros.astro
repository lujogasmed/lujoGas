---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import CTASection from '../components/organisms/CTASection.astro';
import EyebrowLabel from '../components/atoms/EyebrowLabel.astro';
import StatCounter from '../components/molecules/StatCounter.astro';
import { SITE } from '../lib/constants';
import { zonas } from '../data/zonas';

const stats = [
  { value: 3, suffix: '+', label: 'Años en instalación de gas' },
  { value: 3000, suffix: '+', label: 'Certificaciones realizadas' },
  { value: 10, suffix: '+', label: 'Municipios cubiertos' },
  { value: 500, suffix: '+', label: 'Instalaciones realizadas' },
];

const timeline = [
  {
    eyebrow: 'Mi historia',
    title: 'De la logística al gas',
    body: 'Durante varios años trabajé como auxiliar en logística, una etapa que me enseñó el valor de la responsabilidad, el orden y el compromiso. Sin embargo, dentro de mí siempre existió el deseo de crecer profesionalmente y brindarle una mejor calidad de vida a mi familia.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25"/></svg>`,
  },
  {
    eyebrow: 'Certificación',
    title: 'Técnico certificado en gas en Medellín',
    body: 'Hace dos años tomé una decisión que marcó un antes y un después: certificarme en el área de gas. No fue un camino fácil, pero con esfuerzo, disciplina y dedicación logré formarme como técnico certificado, adquiriendo conocimientos que hoy me permiten desempeñarme con seguridad y profesionalismo en cada instalación en Medellín y el Valle de Aburrá. Para mí, la certificación no es solo un requisito — es el respaldo de un trabajo bien hecho y seguro.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.745 3.745 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.745 3.745 0 0 1 3.296-1.043A3.745 3.745 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.745 3.745 0 0 1 3.296 1.043 3.745 3.745 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"/></svg>`,
  },
  {
    eyebrow: 'Mis metas',
    title: 'Ser referente en gas en Medellín',
    body: 'Mi objetivo es seguir creciendo como profesional, mejorar cada día y brindar un servicio de gas de calidad en Medellín y el Valle de Aburrá. Busco ser reconocido por mi responsabilidad, honestidad y compromiso con la seguridad de cada cliente. Cada trabajo que realizo lo hago pensando en la seguridad de cada hogar.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/></svg>`,
  },
];

const values = [
  {
    title: 'Certificación real',
    desc: 'Cada trabajo termina con certificado oficial emitido por organismo acreditado. No firmamos algo que no podamos respaldar.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.745 3.745 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.745 3.745 0 0 1 3.296-1.043A3.745 3.745 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.745 3.745 0 0 1 3.296 1.043 3.745 3.745 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z"/></svg>`,
  },
  {
    title: 'Materiales NTC',
    desc: 'Solo usamos tuberías, válvulas y accesorios con certificación de Norma Técnica Colombiana. Sin atajos.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>`,
  },
  {
    title: 'Técnico certificado',
    desc: 'Formación y certificación verificada. Actualización constante en normativa técnica colombiana para instalaciones de gas en Medellín.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/></svg>`,
  },
  {
    title: 'Atención oportuna',
    desc: 'Respuesta rápida a cada solicitud. Coordinamos la visita según tu disponibilidad y cumplimos el horario acordado.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>`,
  },
];

const certifications = [
  { seal: 'ICO', title: 'ICONTEC', sub: 'Organismo acreditado — vigente' },
  { seal: 'NTC', title: 'NTC 2505', sub: 'Norma técnica colombiana' },
  {
    seal: 'EPM',
    title: 'Aval EPM / Gas Natural',
    sub: 'Instaladores autorizados',
  },
  { seal: 'ATN', title: 'Atención rápida', sub: 'Visita coordinada contigo' },
];

// Schema Person — E-E-A-T signal para Google
const founderSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Luis Guillermo Muñoz Vélez',
  jobTitle: 'Técnico Certificado en Redes de Gas',
  description:
    'Técnico certificado en instalación, mantenimiento y certificación de redes de gas natural y GLP en Medellín y el Valle de Aburrá, Colombia.',
  worksFor: {
    '@type': 'LocalBusiness',
    name: 'LujoGas',
    url: 'https://lujogas.com.co',
    telephone: SITE.phone,
  },
  knowsAbout: [
    'Instalación de redes de gas natural en Medellín',
    'Certificación de redes de gas residencial NTC 2505',
    'Mantenimiento de redes de gas GLP',
    'Inspección de redes de gas Medellín',
    'Conversión a gas natural Valle de Aburrá',
  ],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Medellín',
    addressRegion: 'Antioquia',
    addressCountry: 'CO',
  },
  telephone: SITE.phone,
  url: 'https://lujogas.com.co/nosotros',
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'Certificado de competencia laboral',
    name: 'Técnico certificado en instalaciones de gas — NTC 2505',
    about: 'Instalaciones para suministro de gas combustible destinadas a usos residenciales y comerciales (NTC 2505)',
    recognizedBy: {
      '@type': 'Organization',
      name: 'ICONTEC',
      url: 'https://www.icontec.org',
    },
  },
  areaServed: zonas.map((z) => ({
    '@type': z.tipo === 'municipio' ? 'City' : 'Place',
    name: z.name,
  })),
};

// FAQ sobre el técnico y la credencial — señal E-E-A-T y contenido citable para IA.
const faqTecnico = [
  {
    q: '¿Qué significa que un técnico de gas esté certificado bajo NTC 2505?',
    a: 'Significa que tiene un certificado de competencia laboral vigente en instalaciones de gas, respaldado por un organismo de inspección acreditado ante el ONAC. La NTC 2505 es la Norma Técnica Colombiana que define materiales, ventilación, distancias de seguridad y pruebas que debe cumplir toda red de gas interna en el país. Sin esa credencial, el documento que se expida no lo acepta la distribuidora.',
  },
  {
    q: '¿Quién ejecuta el trabajo que contrato con LujoGas?',
    a: 'El mismo técnico que firma el certificado: Luis Guillermo Muñoz Vélez. LujoGas no es un call center ni una intermediación que reparte la visita a terceros. Quien evalúa, ejecuta y responde por la instalación es la misma persona, de principio a fin.',
  },
  {
    q: '¿EPM certifica la red de gas de mi casa?',
    a: 'No. EPM distribuye el gas y exige el certificado vigente para activar o mantener activo el servicio, pero no certifica ni repara la red interna del inmueble. Esa parte la ejecuta un técnico certificado NTC 2505 respaldado por un organismo de inspección acreditado.',
  },
  {
    q: '¿Qué recibo al terminar el trabajo?',
    a: 'El certificado oficial que ampara la instalación, entregado en 24 a 48 horas hábiles una vez aprobada la revisión, y el reporte técnico con lo que se verificó y lo que se corrigió. Ese certificado es el documento que la distribuidora exige y el que queda vigente hasta la siguiente revisión periódica.',
  },
  {
    q: '¿En qué zonas del Valle de Aburrá atiende el técnico?',
    a: 'Medellín y su área metropolitana: El Poblado, Laureles, Belén, Robledo, Envigado, Sabaneta, Itagüí, La Estrella, Bello y Copacabana, además de corregimientos cercanos. La visita diagnóstica se coordina por WhatsApp según disponibilidad de agenda.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqTecnico.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// BreadcrumbList schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Inicio',
      item: 'https://lujogas.com.co/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Nosotros — Técnico certificado en gas Medellín',
      item: 'https://lujogas.com.co/nosotros',
    },
  ],
};
---

<!--
  SEO: title 52 chars, meta description 157 chars.
  Schema: Person (E-E-A-T) + BreadcrumbList en body (válido per Google spec).
  H1 incluye keyword principal + "Medellín".
-->
<BaseLayout
  title="Técnico Certificado en Gas en Medellín | LujoGas"
  description="Luis Guillermo Muñoz Vélez, técnico certificado en instalación de gas en Medellín. Certificación ICONTEC y materiales NTC 2505 en el Valle de Aburrá."
  canonical="https://lujogas.com.co/nosotros"
>
  <Header />

  <main>
    <!-- Schema JSON-LD en body — Google lo acepta fuera de <head> -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(founderSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(faqSchema)}
    />

    <!-- ── Page Hero ── -->
    <section
      class="relative overflow-hidden pt-[140px]"
      style="background-color: #333333;"
      aria-labelledby="nosotros-heading"
    >
      <div class="pipes-bg" aria-hidden="true"></div>
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse 60% 90% at 90% 50%, rgba(249,115,22,0.12) 0%, transparent 65%);"
        aria-hidden="true"
      >
      </div>

      <div class="container-section relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-end">
          <!-- ── Text column ── -->
          <div class="md:pb-[80px]">
            <div class="flex items-center gap-3 mb-5">
              <span class="block w-8 h-px" style="background:#F97316;"></span>
              <span
                class="font-mono text-[11px] font-semibold tracking-[0.26em] uppercase"
                style="color:#F97316;"
              >
                LujoGas · Nosotros
              </span>
            </div>
            <!-- H1: keyword "técnico certificado en gas" + "Medellín" en primeras palabras -->
            <h1
              id="nosotros-heading"
              class="font-display font-semibold leading-[0.97] tracking-[-0.01em] text-background mb-5"
              style="font-size: clamp(40px,5.5vw,78px); max-width: 16ch;"
            >
              Técnico certificado en gas en Medellín, al servicio de tu hogar
            </h1>
            <p
              class="text-neutral/70 max-w-[52ch]"
              style="font-size: clamp(15px,1.3vw,17px); line-height: 1.65;"
            >
              Soy Luis Guillermo Muñoz Vélez, técnico certificado en instalación
              y certificación de redes de gas en Medellín y el Valle de Aburrá.
              Cada trabajo lo realizo con compromiso, responsabilidad y pensando
              en la seguridad de cada hogar.
            </p>
          </div>

          <!-- ── Photo column ── -->
          <div
            class="relative flex justify-center lg:justify-end items-end hero-photo-enter"
          >
            <div class="hero-photo-glow" aria-hidden="true"></div>
            <img
              src="https://res.cloudinary.com/dxcbyed7d/image/upload/v1781108208/servigas-full-calidad_vormpn.webp"
              alt="Luis Guillermo Muñoz Vélez — técnico certificado en instalación de gas en Medellín"
              class="relative z-10 w-auto max-w-full object-contain"
              style="max-height: clamp(550px, 50vw, 600px);"
              width="480"
              height="600"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <div
        class="absolute bottom-0 left-0 right-0 h-16 pointer-events-none"
        style="background: linear-gradient(to bottom, transparent, #F8F7F4);"
        aria-hidden="true"
      >
      </div>
    </section>

    <!-- ── Stats ── -->
    <section class="bg-background py-16" aria-label="Números LujoGas">
      <div class="container-section">
        <div
          class="grid grid-cols-2 md:grid-cols-4 border border-neutral/15 rounded-2xl overflow-hidden reveal"
        >
          {
            stats.map((s) => (
              <StatCounter value={s.value} suffix={s.suffix} label={s.label} />
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Presentación del fundador ── -->
    <section
      class="section-pad bg-background"
      aria-labelledby="fundador-heading"
    >
      <div class="container-section">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center reveal">
          <!-- Text -->
          <div>
            <EyebrowLabel text="El técnico detrás de LujoGas" />
            <!-- H2: nombre completo + keyword local para E-E-A-T -->
            <h2
              id="fundador-heading"
              class="font-display font-semibold text-primary mt-3 mb-6 leading-tight"
              style="font-size:clamp(30px,3.5vw,46px);"
            >
              Luis Guillermo Muñoz Vélez — técnico certificado en gas, Medellín
            </h2>
            <div
              class="flex flex-col gap-4 text-muted text-[15.5px] leading-relaxed"
            >
              <p>
                Soy un hombre casado y padre de dos hijos maravillosos, Samuel y
                Laura, quienes son mi mayor motivación para salir adelante cada
                día. Esa motivación es la misma que pongo en cada instalación de
                gas que realizo en Medellín.
              </p>
              <p>
                Hace dos años tomé una decisión que marcó un antes y un después
                en mi vida: certificarme como técnico en el área de gas. No fue
                un camino fácil, pero con esfuerzo, disciplina y dedicación
                logré la formación que hoy me permite desempeñarme con seguridad
                y profesionalismo en cada red de gas que instalo o certifico en
                Medellín, el Valle de Aburrá y corregimientos cercanos.
              </p>
              <p>
                Hoy me siento orgulloso de lo que he logrado. Cada trabajo que
                realizo lo hago con compromiso, responsabilidad y pensando
                siempre en la seguridad de cada hogar.
              </p>
            </div>
          </div>
          <!-- Photo panel — Luis con certificado -->
          <div class="relative rounded-2xl overflow-hidden" style="min-height:340px;">
            <img
              src="https://res.cloudinary.com/dxcbyed7d/image/upload/v1781108208/lujogas3_ezview.webp"
              alt="Luis Guillermo Muñoz Vélez mostrando certificado de instalación de gas en Medellín — LujoGas"
              class="w-full h-full object-cover object-top"
              style="min-height:340px; max-height:480px;"
              width="560"
              height="480"
              loading="lazy"
              decoding="async"
            />
            <!-- Quote overlay -->
            <div
              class="absolute bottom-0 left-0 right-0 p-7"
              style="background: linear-gradient(to top, rgba(13,13,13,0.88) 0%, rgba(13,13,13,0.55) 60%, transparent 100%);"
            >
              <p class="font-display text-[clamp(18px,2vw,24px)] font-semibold text-white leading-tight mb-3">
                "Cada instalación la hago<br />
                <span style="color:#F97316;">pensando en la seguridad<br />de tu hogar."</span>
              </p>
              <p class="text-white/70 text-[13px] font-mono tracking-wide">
                Luis Guillermo Muñoz Vélez — Técnico certificado, LujoGas
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Historia / Certificación / Metas ── -->
    <section
      class="section-pad"
      style="background:#F8F7F4;"
      aria-labelledby="trayectoria-heading"
    >
      <div class="container-section">
        <div class="text-center mb-14 reveal">
          <EyebrowLabel text="Trayectoria" />
          <h2
            id="trayectoria-heading"
            class="font-display font-semibold text-primary mt-3 leading-tight"
            style="font-size:clamp(30px,3.5vw,46px);"
          >
            De dónde vengo y hacia dónde voy
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 reveal-stagger">
          {
            timeline.map((item) => (
              <div class="group bg-surface border border-neutral/15 rounded-2xl p-8 flex flex-col gap-5 hover:border-tertiary/30 hover:shadow-md transition-all duration-300">
                <div class="w-11 h-11 rounded-xl bg-tertiary/8 border border-tertiary/18 text-tertiary flex items-center justify-center flex-shrink-0 group-hover:bg-tertiary/16 transition-all duration-300">
                  <span class="w-5 h-5 block" set:html={item.icon} />
                </div>
                <div>
                  <p
                    class="font-mono text-[11px] font-semibold tracking-[0.22em] uppercase mb-2"
                    style="color:#F97316;"
                  >
                    {item.eyebrow}
                  </p>
                  <h3 class="font-display font-semibold text-primary text-[18px] leading-snug mb-3">
                    {item.title}
                  </h3>
                  <p class="text-muted text-[14.5px] leading-relaxed">
                    {item.body}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Valores ── -->
    <section
      class="section-pad bg-background"
      aria-labelledby="valores-heading"
    >
      <div class="container-section">
        <div class="text-center mb-14 reveal">
          <EyebrowLabel text="Cómo trabajo" />
          <h2
            id="valores-heading"
            class="font-display font-semibold text-primary mt-3 leading-tight"
            style="font-size:clamp(30px,3.5vw,46px);"
          >
            Los principios que no negocio
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 reveal-stagger">
          {
            values.map((v) => (
              <div class="group bg-surface border border-neutral/15 rounded-2xl p-7 flex gap-5 hover:border-tertiary/30 hover:shadow-md transition-all duration-300">
                <div class="w-11 h-11 rounded-xl bg-tertiary/8 border border-tertiary/18 text-tertiary flex items-center justify-center flex-shrink-0 group-hover:bg-tertiary/16 transition-all duration-300">
                  <span class="w-5 h-5 block" set:html={v.icon} />
                </div>
                <div>
                  <h3 class="font-display font-semibold text-primary text-[18px] tracking-[0.01em] mb-2">
                    {v.title}
                  </h3>
                  <p class="text-muted text-[14px] leading-relaxed">{v.desc}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ── Certificaciones ── -->
    <section
      class="section-pad"
      style="background-color:#1A1A2E;"
      aria-labelledby="certs-heading"
    >
      <div class="pipes-bg" aria-hidden="true"></div>
      <div class="container-section relative z-10">
        <div class="text-center mb-12 reveal">
          <EyebrowLabel text="Certificaciones" />
          <h2
            id="certs-heading"
            class="font-display font-semibold text-background mt-3 leading-tight"
            style="font-size:clamp(30px,3.5vw,46px);"
          >
            Certificado, medible, verificable
          </h2>
          <p class="text-neutral/55 mt-4 max-w-[48ch] mx-auto text-[15px]">
            Mi certificación como técnico en gas en Medellín no es solo un papel
