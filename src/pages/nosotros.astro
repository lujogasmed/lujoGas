---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import CTASection from '../components/organisms/CTASection.astro';
import EyebrowLabel from '../components/atoms/EyebrowLabel.astro';
import StatCounter from '../components/molecules/StatCounter.astro';
import WhatsAppIcon from '../components/atoms/WhatsAppIcon.astro';
import { SITE, WHATSAPP_NUMBER } from '../lib/constants';
import { zonas } from '../data/zonas';
import { TECNICO, FOTO_CERTIFICADO } from '../data/tecnico';

const PAGE_URL = 'https://lujogas.com.co/nosotros';
const anios = new Date().getFullYear() - TECNICO.inicioEnGas;
const telefonoVisible = SITE.phone.replace(/^\+57(\d{3})(\d{3})(\d{4})$/, '+57 $1 $2 $3');
const fechaActualizado = new Date(`${TECNICO.actualizado}T12:00:00-05:00`).toLocaleDateString('es-CO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

const wa = (msg: string) => `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(msg)}`;
const waCredencial = wa(
  'Hola Luis, antes de agendar quiero verificar tu certificado de competencia laboral en gas y el organismo de inspección que respalda el certificado.',
);
const waVisita = wa('Hola Luis, quiero agendar una visita técnica de gas en Medellín.');

// ── Credencial: solo se publican campos con dato real ─────────────────────
const { credencial, organismo } = TECNICO;
const vigencia = credencial.vigenteHasta
  ? new Date(`${credencial.vigenteHasta}T12:00:00-05:00`).toLocaleDateString('es-CO', {
      month: 'long',
      year: 'numeric',
    })
  : null;
const credencialFilas = [
  { k: 'Documento', v: credencial.nombre },
  { k: 'Expedido por', v: credencial.emisor },
  { k: 'Número', v: credencial.numero },
  { k: 'Vigente hasta', v: vigencia },
  { k: 'Organismo de inspección', v: organismo.nombre },
  { k: 'Acreditación ONAC', v: organismo.codigoOnac },
].filter((f): f is { k: string; v: string } => Boolean(f.v));
const credencialCompleta = Boolean(credencial.numero && organismo.nombre);

const stats = [
  { value: anios, suffix: '+', label: 'Años trabajando redes de gas' },
  { value: TECNICO.certificaciones, suffix: '+', label: 'Certificaciones realizadas' },
  { value: TECNICO.instalaciones, suffix: '+', label: 'Instalaciones realizadas' },
  { value: zonas.length, suffix: '', label: 'Zonas del Valle de Aburrá' },
];

// ── Ficha de datos (bloque citable por buscadores e IA) ───────────────────
const ficha = [
  { k: 'Técnico responsable', v: TECNICO.nombre },
  { k: 'Norma que aplica', v: 'NTC 2505 — instalaciones de gas residenciales y comerciales' },
  { k: 'Trabaja en gas desde', v: `${TECNICO.inicioEnGas} · certificado desde ${TECNICO.anioCertificacion}` },
  { k: 'Certificaciones realizadas', v: `Más de ${TECNICO.certificaciones.toLocaleString('es-CO')}` },
  { k: 'Visita diagnóstica', v: '$50.000, descontable si contratas el servicio' },
  { k: 'Certificación / RPO', v: 'Desde $150.000 · certificado en 24–48 h hábiles' },
  { k: 'Instalación residencial', v: 'Desde $850.000 con certificado incluido' },
  { k: 'Cobertura', v: 'Medellín, Envigado, Sabaneta, Itagüí, La Estrella, Bello y Copacabana' },
  { k: 'Horario', v: SITE.schedule },
  { k: 'Dirección', v: `${SITE.address}, ${SITE.city}, ${SITE.region}` },
  { k: 'Teléfono / WhatsApp', v: telefonoVisible },
];

// ── Verificación de cualquier técnico ─────────────────────────────────────
const verificar = [
  {
    t: 'Pide el certificado de competencia laboral a nombre de la persona',
    d: 'El documento que habilita a firmar es personal, no de la empresa. Revisa que el nombre coincida con quien va a tu casa y que la fecha de vigencia no esté vencida.',
  },
  {
    t: 'Pregunta qué organismo de inspección respalda el certificado',
    d: 'El certificado de tu instalación lo respalda un organismo de inspección acreditado. Búscalo por nombre en el directorio público del ONAC y confirma que la acreditación esté vigente para instalaciones de gas.',
  },
  {
    t: 'Desconfía de "autorizado por EPM"',
    d: 'EPM distribuye el gas y exige el certificado, pero no publica una lista oficial de técnicos para la red interna. Quien usa esa frase como única credencial te está pidiendo fe, no pruebas.',
  },
  {
    t: 'Exige el presupuesto por escrito antes de que intervenga',
    d: 'Una revisión seria termina en un informe de hallazgos y un valor cerrado para corregirlos. Si el precio aparece después de abrir la pared, el riesgo es tuyo.',
  },
  {
    t: 'Confirma qué recibes al final',
    d: 'Certificado de la instalación y reporte técnico de lo verificado y lo corregido. Es lo que EPM pide para activar o mantener el servicio hasta la siguiente revisión periódica.',
  },
];

// ── Método de trabajo ─────────────────────────────────────────────────────
const metodo = [
  {
    t: 'Contacto por WhatsApp',
    d: 'Me cuentas qué necesitas. Te respondo con precio base, disponibilidad y, si lo pides, foto de mi credencial vigente.',
  },
  {
    t: 'Visita diagnóstica',
    d: 'Recorro la red completa desde el medidor hasta cada gasodoméstico: trazado, materiales, uniones, válvulas y regulador.',
  },
  {
    t: 'Prueba de hermeticidad',
    d: 'La red se somete a presión y se verifica con manómetro que no la pierda. Es la prueba que confirma o descarta una fuga oculta en paredes o pisos.',
  },
  {
    t: 'Ventilación y combustión',
    d: 'Reviso rejillas, volumen del recinto y ducto del calentador, y mido monóxido de carbono en el ambiente con los equipos encendidos.',
  },
  {
    t: 'Presupuesto cerrado',
    d: 'Si hay hallazgos, te entrego el valor de la corrección antes de tocar nada. Tú decides.',
  },
  {
    t: 'Corrección con materiales NTC',
    d: 'Tubería, válvulas y accesorios con sello de Norma Técnica Colombiana. Sin materiales sin certificar que luego reprueben la revisión.',
  },
  {
    t: 'Certificado en 24–48 h',
    d: 'Aprobada la instalación, recibes el certificado y el reporte técnico. El mismo técnico que visitó es el que firma.',
  },
];

// ── Hallazgos frecuentes por zona (experiencia de campo) ──────────────────
const hallazgos = [
  {
    h: 'Regulador fuera de vida útil',
    donde: 'Casas tradicionales del centro de Itagüí y Bello',
    href: '/instalacion-gas-itagui',
    implica: 'No conformidad en la RPO. Se reemplaza el regulador y se repite la prueba.',
  },
  {
    h: 'Tubería galvanizada con corrosión',
    donde: 'Casas de 40 años o más en Laureles y Los Conquistadores',
    href: '/instalacion-gas-laureles',
    implica: 'Reemplazo de los tramos afectados; a veces de la red completa.',
  },
  {
    h: 'Cocina cerrada sin ventilación',
    donde: 'Remodelaciones en Laureles y casas de Copacabana',
    href: '/instalacion-gas-copacabana',
    implica: 'La NTC 2505 no lo deja pasar: afecta la evacuación de gases de combustión.',
  },
  {
    h: 'Calentador de paso sin ducto ni rejillas',
    donde: 'Apartamentos de El Tesoro y Los Balsos, en El Poblado',
    href: '/instalacion-gas-el-poblado',
    implica: 'Hay que instalar ducto de evacuación y rejillas reglamentarias antes de certificar.',
  },
  {
    h: 'Tramos añadidos sin certificar',
    donde: 'Viviendas con ampliaciones sucesivas en Bello',
    href: '/instalacion-gas-bello',
    implica: 'El tramo nuevo se prueba y se certifica, o se rehace si no cumple.',
  },
  {
    h: 'Red nueva entregada sin certificado',
    donde: 'Torres nuevas en las lomas de Envigado y en Bello',
    href: '/instalacion-gas-envigado',
    implica: 'EPM no activa el medidor hasta que exista certificado vigente de la red interna.',
  },
];

const principios = [
  {
    t: 'Quien visita, firma',
    d: 'LujoGas no es un call center. El técnico que evalúa tu red es el mismo que corrige y responde por el certificado.',
  },
  {
    t: 'Materiales con sello NTC',
    d: 'Solo tuberías, válvulas y accesorios certificados bajo Norma Técnica Colombiana. Sin atajos.',
  },
  {
    t: 'Precio antes de intervenir',
    d: 'Visita de $50.000 descontable y presupuesto cerrado por escrito antes de cualquier corrección.',
  },
  {
    t: 'Horario que se cumple',
    d: 'La visita se coordina por WhatsApp según tu disponibilidad y se respeta la hora acordada.',
  },
];

const faqTecnico = [
  {
    q: '¿Qué significa que un técnico de gas esté certificado bajo NTC 2505?',
    a: 'Que tiene un certificado de competencia laboral vigente en instalaciones de gas, y que el certificado de tu instalación lo respalda un organismo de inspección acreditado ante el ONAC. La NTC 2505 define materiales, ventilación, distancias de seguridad y pruebas que debe cumplir toda red de gas interna en Colombia. Sin esa credencial, EPM no acepta el documento.',
  },
  {
    q: '¿Cómo verifico que Luis Guillermo Muñoz Vélez está certificado?',
    a: 'Pídele por WhatsApp, antes de agendar, foto de su certificado de competencia laboral y el nombre del organismo de inspección que respalda el certificado. El nombre del organismo lo puedes buscar en el directorio público del ONAC para confirmar que su acreditación está vigente.',
  },
  {
    q: '¿Quién ejecuta el trabajo que contrato con LujoGas?',
    a: 'El mismo técnico que firma el certificado: Luis Guillermo Muñoz Vélez. LujoGas no reparte la visita a terceros. Quien evalúa, ejecuta y responde por la instalación es la misma persona.',
  },
  {
    q: '¿EPM certifica la red de gas de mi casa?',
    a: 'No. EPM distribuye el gas y exige el certificado vigente para activar o mantener el servicio, pero no certifica ni repara la red interna del inmueble. Eso lo hace un técnico certificado NTC 2505 respaldado por un organismo de inspección acreditado.',
  },
  {
    q: '¿Cuánta experiencia tiene el técnico?',
    a: `Trabaja en redes de gas desde ${TECNICO.inicioEnGas}, está certificado desde ${TECNICO.anioCertificacion} y ha realizado más de ${TECNICO.certificaciones.toLocaleString('es-CO')} certificaciones y ${TECNICO.instalaciones} instalaciones en Medellín y el Valle de Aburrá.`,
  },
  {
    q: '¿Cuánto cuesta la visita técnica?',
    a: 'La visita diagnóstica cuesta $50.000 y se descuenta si contratas el servicio. La certificación o revisión periódica parte de $150.000 y la instalación residencial de 1 a 2 puntos desde $850.000 con certificado incluido.',
  },
  {
    q: '¿Qué recibo al terminar el trabajo?',
    a: 'El certificado de la instalación, entregado en 24 a 48 horas hábiles una vez aprobada la revisión, y el reporte técnico con lo verificado y lo corregido. Ese certificado es el que EPM exige y queda vigente hasta la siguiente revisión periódica.',
  },
  {
    q: '¿En qué zonas del Valle de Aburrá atiende?',
    a: `Medellín y su área metropolitana: ${zonas.map((z) => z.name).join(', ')}. La visita se coordina por WhatsApp según disponibilidad de agenda.`,
  },
];

// ── Schema ────────────────────────────────────────────────────────────────
const personSchema = {
  '@type': 'Person',
  '@id': TECNICO.id,
  name: TECNICO.nombre,
  jobTitle: TECNICO.cargo,
  url: TECNICO.url,
  image: TECNICO.fotoSchema,
  telephone: SITE.phone,
  description: `Técnico certificado NTC 2505 en instalación, mantenimiento, revisión periódica y certificación de redes de gas en Medellín y el Valle de Aburrá. Más de ${TECNICO.certificaciones} certificaciones realizadas.`,
  worksFor: { '@id': 'https://lujogas.com.co/#localbusiness' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address,
    addressLocality: SITE.city,
    addressRegion: SITE.region,
    postalCode: SITE.postalCode,
    addressCountry: SITE.country,
  },
  knowsAbout: [
    'NTC 2505',
    'Instalación de redes de gas natural',
    'Revisión Periódica Obligatoria de gas',
    'Certificación de instalaciones de gas',
    'Prueba de hermeticidad',
    'Ventilación de recintos con gasodomésticos',
    'Monóxido de carbono',
    'Gas natural y GLP',
  ],
  hasOccupation: {
    '@type': 'Occupation',
    name: 'Técnico de redes de gas',
    occupationLocation: zonas
      .filter((z) => z.tipo === 'municipio')
      .map((z) => ({ '@type': 'City', name: z.name })),
  },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    credentialCategory: 'Certificado de competencia laboral',
    name: credencial.nombre,
    ...(credencial.numero && { identifier: credencial.numero }),
    ...(credencial.vigenteHasta && { validUntil: credencial.vigenteHasta }),
    ...(credencial.emisor && {
      recognizedBy: {
        '@type': 'Organization',
        name: credencial.emisor,
        ...(credencial.urlVerificacion && { url: credencial.urlVerificacion }),
      },
    }),
  },
};

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${PAGE_URL}#webpage`,
  url: PAGE_URL,
  name: 'Técnico certificado de gas en Medellín — Luis Guillermo Muñoz Vélez',
  inLanguage: 'es-CO',
  dateModified: TECNICO.actualizado,
  about: { '@id': 'https://lujogas.com.co/#localbusiness' },
  mainEntity: personSchema,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://lujogas.com.co/' },
    { '@type': 'ListItem', position: 2, name: 'Técnico certificado de gas en Medellín', item: PAGE_URL },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqTecnico.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const linkClass = 'font-semibold text-tertiary underline underline-offset-2 hover:text-primary';
---

<!--
  SEO: title 51 chars · meta 157 chars · H1 único con keyword + Medellín.
  Schema: ProfilePage > Person (@id enlazado a LocalBusiness y al autor del blog) + BreadcrumbList + FAQPage.
  Datos de credencial en src/data/tecnico.ts (solo se publican si son reales).
-->
<BaseLayout
  title="Técnico Certificado de Gas en Medellín — Luis Muñoz"
  description="Luis Guillermo Muñoz Vélez, técnico certificado NTC 2505 en Medellín: +3.000 certificaciones de gas, visita $50.000 y certificado en 24–48 h. Verifícalo aquí."
  canonical={PAGE_URL}
  ogType="profile"
>
  <Header />

  <main>
    <script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- ── Hero ── -->
    <section class="relative overflow-hidden bg-primary pt-[120px] md:pt-[140px]" aria-labelledby="nosotros-heading">
      <div class="pipes-bg" aria-hidden="true"></div>
      <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_60%_90%_at_90%_50%,rgba(249,115,22,0.12)_0%,transparent_65%)]"
        aria-hidden="true"
      >
      </div>

      <div class="container-section relative z-10">
        <div class="grid grid-cols-1 items-end gap-8 lg:grid-cols-2 lg:gap-16">
          <div class="pb-4 md:pb-20">
            <nav aria-label="Ruta de navegación" class="mb-5 font-mono text-[12px] uppercase tracking-[0.2em] text-neutral/60">
              <a href="/" class="hover:text-tertiary">Inicio</a>
              <span class="mx-2" aria-hidden="true">/</span>
              <span class="text-tertiary">Técnico certificado</span>
            </nav>
            <h1
              id="nosotros-heading"
              class="mb-5 max-w-[18ch] font-display text-[clamp(40px,5.5vw,76px)] font-semibold leading-[0.97] tracking-[-0.01em] text-background"
            >
              Técnico certificado de gas en Medellín: Luis Guillermo Muñoz Vélez
            </h1>
            <p class="max-w-[56ch] text-[15px] leading-relaxed text-neutral/80 md:text-[17px]">
              LujoGas es el servicio de gas de Luis Guillermo Muñoz Vélez, técnico con certificado de
              competencia laboral bajo la <strong class="text-background">NTC 2505</strong>. Trabaja
              redes de gas en Medellín y el Valle de Aburrá desde {TECNICO.inicioEnGas} y ha realizado
              más de {TECNICO.certificaciones.toLocaleString('es-CO')} certificaciones. El mismo técnico
              visita, corrige y firma: visita de $50.000 y certificado en 24 a 48 horas hábiles.
            </p>
            <div class="mt-7 flex flex-col gap-3 sm:flex-row">
              <a
                href={waVisita}
                target="_blank"
                rel="noopener"
                data-wa-source="nosotros_hero"
                class="inline-flex min-h-[48px] items-center justify-center gap-2 rounded-xl bg-whatsapp px-6 font-semibold text-white transition-colors hover:bg-whatsapp-dark"
              >
                <WhatsAppIcon size={20} />
                Agendar visita
              </a>
              <a
                href="#credencial"
                class="inline-flex min-h-[48px] items-center justify-center rounded-xl border border-neutral/30 px-6 font-semibold text-background transition-colors hover:border-tertiary hover:text-tertiary"
              >
                Verificar credencial
              </a>
            </div>
            <p class="mt-5 font-mono text-[12px] uppercase tracking-[0.18em] text-neutral/50">
              Datos revisados el <time datetime={TECNICO.actualizado}>{fechaActualizado}</time>
            </p>
          </div>

          <div class="hero-photo-enter relative flex items-end justify-center lg:justify-end">
            <div class="hero-photo-glow" aria-hidden="true"></div>
            <img
              src={TECNICO.foto}
              alt="Luis Guillermo Muñoz Vélez, técnico certificado de gas en Medellín"
              class="relative z-10 max-h-[clamp(420px,50vw,600px)] w-auto max-w-full object-contain"
              width="480"
              height="600"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>

      <div class="pointer-events-none absolute bottom-0 left-0 right-0 h-16 bg-gradient-to-b from-transparent to-background" aria-hidden="true">
      </div>
    </section>

    <!-- ── Stats ── -->
    <section class="bg-background py-12 md:py-16" aria-label="LujoGas en cifras">
      <div class="container-section">
        <div class="reveal grid grid-cols-2 overflow-hidden rounded-2xl border border-neutral/15 md:grid-cols-4">
          {stats.map((s) => <StatCounter value={s.value} suffix={s.suffix} label={s.label} />)}
        </div>
      </div>
    </section>

    <!-- ── Ficha de datos ── -->
    <section class="bg-background pb-16 md:pb-24" aria-labelledby="ficha-heading">
      <div class="container-section">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.3fr] lg:gap-16">
          <div class="reveal">
            <EyebrowLabel text="Ficha del servicio" />
            <h2 id="ficha-heading" class="mb-5 mt-3 font-display text-[clamp(30px,3.5vw,46px)] font-semibold leading-tight text-primary">
              LujoGas en datos verificables
            </h2>
            <p class="text-[15.5px] leading-relaxed text-muted">
              Lo esencial para decidir antes de escribir: quién va a tu casa, qué norma aplica, cuánto
              cuesta y dónde trabaja. Los precios son los mismos que aparecen en las páginas de
              <a href="/instalacion-gas-medellin" class={linkClass}>instalación de gas</a>,
              <a href="/certificacion-gas-medellin" class={linkClass}>certificación de gas</a> y
              <a href="/rpo-gas-medellin" class={linkClass}>revisión periódica</a>.
            </p>
          </div>
          <dl class="reveal divide-y divide-neutral/20 overflow-hidden rounded-2xl border border-neutral/20 bg-surface">
            {
              ficha.map((f) => (
                <div class="grid grid-cols-1 gap-1 px-5 py-4 sm:grid-cols-[200px_1fr] sm:gap-4 md:px-6">
                  <dt class="font-mono text-[12px] font-semibold uppercase tracking-[0.16em] text-tertiary">{f.k}</dt>
                  <dd class="text-[15px] text-primary">{f.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <!-- ── Historia ── -->
    <section class="section-pad bg-bg-alt" aria-labelledby="fundador-heading">
      <div class="container-section">
        <div class="reveal grid grid-cols-1 items-center gap-12 lg:grid-cols-2 lg:gap-16">
          <div>
            <EyebrowLabel text="El técnico detrás de LujoGas" />
            <h2 id="fundador-heading" class="mb-6 mt-3 font-display text-[clamp(30px,3.5vw,46px)] font-semibold leading-tight text-primary">
              De la logística a las redes de gas del Valle de Aburrá
            </h2>
            <div class="flex flex-col gap-4 text-[15.5px] leading-relaxed text-muted">
              <p>
                Durante varios años trabajé como auxiliar de logística. Esa etapa me enseñó orden,
                puntualidad y a responder por lo que se entrega. Pero quería crecer y darle una mejor
                vida a mi familia: estoy casado y soy papá de Samuel y Laura.
              </p>
              <p>
                En {TECNICO.inicioEnGas} empecé a trabajar en redes de gas y en {TECNICO.anioCertificacion} obtuve
                mi certificación como técnico bajo la NTC 2505. Desde entonces he hecho más de
                {' '}{TECNICO.certificaciones.toLocaleString('es-CO')} certificaciones y {TECNICO.instalaciones} instalaciones en
                Medellín, Envigado, Itagüí, Sabaneta, Bello y el resto del área metropolitana.
              </p>
              <p>
                Ese volumen se explica por la revisión periódica obligatoria: cada vivienda con gas
                natural debe certificarse cada cinco años, y buena parte de mi trabajo diario es
                revisar, corregir hallazgos y dejar la instalación lista para que
                <a href="/blog/quien-certifica-gas-epm-o-tecnico-certificado" class={linkClass}>EPM mantenga el servicio</a>.
              </p>
              <p>
                Mi meta es simple: que cada cliente sepa quién entró a su casa, qué se revisó y por qué
                el certificado que firmé es válido.
              </p>
            </div>
          </div>
          <figure class="relative overflow-hidden rounded-2xl bg-surface">
            <img
              src={FOTO_CERTIFICADO.src}
              alt={FOTO_CERTIFICADO.alt}
              class="h-full max-h-[480px] min-h-[340px] w-full object-cover object-top"
