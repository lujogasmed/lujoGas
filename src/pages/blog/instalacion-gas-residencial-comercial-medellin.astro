---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/organisms/Header.astro';
import Footer from '../../components/organisms/Footer.astro';
import CTASection from '../../components/organisms/CTASection.astro';
import EyebrowLabel from '../../components/atoms/EyebrowLabel.astro';
import Button from '../../components/atoms/Button.astro';
import WhatsAppIcon from '../../components/atoms/WhatsAppIcon.astro';
import { getCollection } from 'astro:content';
import { WHATSAPP_URL } from '../../lib/constants';

const allPosts = await getCollection('blog');
const articles = allPosts.filter(p => p.data.pillar === 3).sort((a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime());

const pillarSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guía de Instalación de Gas Residencial y Comercial en Medellín',
  description: 'Guía completa de instalación de gas en Medellín: precios, tipos de instalación, cómo elegir técnico, gas natural vs GLP y más.',
  url: 'https://lujogas.com.co/blog/instalacion-gas-residencial-comercial-medellin',
  inLanguage: 'es-CO',
  author: { '@type': 'Person', name: 'Luis Guillermo Muñoz Vélez' },
  publisher: { '@type': 'Organization', name: 'LujoGas', url: 'https://lujogas.com.co' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.data.title,
      url: `https://lujogas.com.co/blog/${a.slug}`,
    })),
  },
};

// FAQ propia del pilar: el hub quedaba por debajo de las 600 palabras y su único
// contenido era el listado del clúster, insuficiente para indexar por sí solo.
const faq = [
  {
    q: "¿Cuánto cuesta instalar gas en una casa en Medellín?",
    a: "Una instalación residencial típica de uno a dos puntos parte de $850.000 con certificado incluido. La visita diagnóstica cuesta $50.000 y se descuenta si contratas el servicio. El valor final depende del recorrido de la tubería, el número de puntos y si hay que resolver ventilación o evacuación.",
  },
  {
    q: "¿Qué diferencia una instalación comercial de una residencial?",
    a: "El cálculo de carga. Un local con varios equipos funcionando a la vez exige diámetros de tubería, presión y ventilación dimensionados a ese consumo simultáneo, muy por encima de una cocina doméstica. También cambian las exigencias de evacuación de gases y, en muchos casos, el certificado se pide en las verificaciones de funcionamiento del establecimiento.",
  },
  {
    q: "¿Cuánto se demora una instalación de gas?",
    a: "Una instalación residencial estándar se ejecuta normalmente en una jornada, según el recorrido y el número de puntos. El certificado se entrega en 24 a 48 horas hábiles una vez aprobada la instalación. Las instalaciones comerciales toman más por el dimensionamiento y las pruebas.",
  },
  {
    q: "¿Gas natural o GLP para mi casa?",
    a: "Si hay red de gas natural disponible en la dirección, casi siempre conviene por costo por metro cúbico y por no depender de cilindros. El GLP tiene sentido donde no llega la red. La comparación con costos está en la guía de gas natural frente a GLP.",
  },
  {
    q: "¿La instalación incluye el certificado?",
    a: "Sí. En LujoGas la instalación se entrega certificada: el mismo técnico que ejecuta la red hace la prueba de hermeticidad y firma el documento que EPM exige para activar el medidor. No hay que contratar a un tercero después.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  title="Instalación de Gas en Medellín: Precios y Tipos"
  description="Guía de instalación de gas en Medellín: precios, tipos de instalación residencial y comercial, gas natural vs GLP y cómo elegir técnico certificado NTC 2505."
  canonical="https://lujogas.com.co/blog/instalacion-gas-residencial-comercial-medellin"
>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(pillarSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <main>
    <section class="relative bg-hero-bg overflow-hidden pt-[140px] pb-[80px] md:pt-[160px] md:pb-[100px]">
      <div class="pipes-bg" />
      <div class="container-section relative z-10">
        <nav class="flex items-center gap-2 text-sm text-hero-text/60 mb-6">
          <a href="/" class="hover:text-blue-bright transition-colors">Inicio</a>
          <span>/</span>
          <a href="/blog" class="hover:text-blue-bright transition-colors">Blog</a>
          <span>/</span>
          <span class="text-hero-text/40">Instalación</span>
        </nav>
        <EyebrowLabel text="Pilar de Contenido" class="mb-2" />
        <h1 class="font-display text-4xl md:text-6xl lg:text-7xl text-background leading-[0.85] tracking-[-0.02em] uppercase max-w-4xl">
          Guía de Instalación de Gas <span class="text-tertiary">Residencial y Comercial</span> en Medellín
        </h1>
        <p class="text-hero-text text-lg md:text-xl max-w-2xl mt-6 leading-relaxed">
          ¿Estás pensando en instalar gas en tu hogar o negocio en Medellín? En esta guía encontrarás precios actualizados, tipos de instalación, diferencias entre gas natural y GLP, y consejos para elegir al técnico certificado adecuado para tu proyecto.
        </p>
      </div>
    </section>

    <section class="section-pad">
      <div class="container-section max-w-[800px]">
        <p class="text-primary/80 text-lg leading-relaxed mb-8">
          Desde <strong>LujoGas</strong> hemos realizado cientos de instalaciones en todo Medellín: desde apartamentos en El Poblado hasta casas en Belén y restaurantes en Laureles. Sabemos que cada proyecto es único, y por eso hemos creado este clúster con información práctica y transparente.
        </p>
        <p class="text-primary/80 text-lg leading-relaxed mb-8">
          ¿Listo para instalar? Cotiza directo en nuestro servicio de <a href="/instalacion-gas-medellin" class="text-tertiary font-semibold underline underline-offset-4 hover:text-tertiary/80 transition-colors">instalación de gas en Medellín</a> con técnico certificado NTC 2505.
        </p>
      </div>
    </section>

    <section class="section-pad bg-surface">
      <div class="container-section">
        <EyebrowLabel text="Artículos del clúster" class="mb-2" />
        <h2 class="font-display text-3xl md:text-4xl text-primary uppercase tracking-[-0.02em] mb-10">
          Todo sobre <span class="text-tertiary">instalación</span> de gas
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
          {articles.map((article) => (
            <a
              href={`/blog/${article.slug}`}
              class="group bg-background rounded-2xl p-6 border border-neutral/20 hover:border-tertiary/30 hover:-translate-y-1 transition-all duration-300"
            >
              <span class="font-mono text-sm text-tertiary mb-2 block">{article.data.readingTime} min</span>
              <h3 class="font-display text-xl text-primary uppercase leading-tight group-hover:text-tertiary transition-colors">
                {article.data.title}
              </h3>
              <p class="text-muted text-sm mt-3 line-clamp-3">{article.data.description}</p>
              <span class="inline-block mt-4 text-sm font-semibold text-tertiary">Leer artículo →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-pad bg-surface">
      <div class="container-section max-w-[800px]">

        <h2 class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6">
          Residencial y comercial: qué cambia de verdad
        </h2>
        <ul class="flex flex-col gap-4 mb-10">
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Cálculo de carga.</strong> En vivienda se dimensiona para estufa y, si aplica, calentador. En comercio hay que sumar el consumo simultáneo de todos los equipos de cocina, lo que cambia diámetros y presión.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Ventilación y evacuación.</strong> Una cocina comercial produce mucho más gas de combustión que una doméstica, y la extracción debe dimensionarse a ese volumen.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Materiales y trazado.</strong> Los mismos materiales certificados NTC, pero con recorridos y protecciones distintas por el tránsito y el uso del espacio. Ver <a href="/blog/tipos-tuberia-gas-cobre-cpvc-polietileno" class="text-tertiary font-semibold underline underline-offset-4">tipos de tubería para gas</a>.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Documentación.</strong> En ambos casos se expide el certificado bajo NTC 2505, pero en comercio suele pedirse además en las verificaciones de funcionamiento del local. Detalle en <a href="/blog/instalacion-gas-para-restaurantes-requisitos-ntc" class="text-tertiary font-semibold underline underline-offset-4">instalación de gas para restaurantes</a>.
          </li>
        </ul>

        <h2 class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6">
          Qué define el precio de una instalación
        </h2>
        <ul class="flex flex-col gap-4 mb-10">
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Número de puntos.</strong> Cada punto adicional suma tubería, accesorios y tiempo de ejecución.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Recorrido de la tubería.</strong> Un trazado corto y accesible cuesta menos que uno que deba rodear, subir un piso o atravesar muros.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Estado del espacio.</strong> Si falta ventilación reglamentaria o hay que habilitar ducto de evacuación para un calentador, ese trabajo se presupuesta aparte.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Tipo de gasodoméstico.</strong> Un calentador de paso exige más caudal y evacuación al exterior; una estufa sola es más simple. Ver <a href="/blog/instalacion-calentador-gas-tipos-precio" class="text-tertiary font-semibold underline underline-offset-4">instalación de calentador a gas</a>.
          </li>
        </ul>

        <p class="text-primary/80 text-lg leading-relaxed mb-10">
          Los precios detallados y el proceso completo están en <a href="/instalacion-gas-medellin" class="text-tertiary font-semibold underline underline-offset-4">instalación de gas en Medellín</a>, y el desglose por tipo de vivienda en <a href="/blog/cuanto-cuesta-instalar-gas-casa-medellin" class="text-tertiary font-semibold underline underline-offset-4">cuánto cuesta instalar gas en casa</a>.
        </p>

        <h2 class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6">
          Preguntas frecuentes
        </h2>
        <div class="flex flex-col gap-4">
          {faq.map((f) => (
            <details class="group border border-neutral/15 rounded-2xl overflow-hidden bg-background">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-display font-semibold text-primary text-[16px] leading-snug list-none">
                {f.q}
                <svg class="flex-shrink-0 transition-transform duration-200 group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <div class="px-6 pb-5 text-muted text-[14.5px] leading-relaxed border-t border-neutral/10 pt-4">
                {f.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />
</BaseLayout>

<script>
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el.classList.add('in');
    } else {
      io.observe(el);
    }
  });
</script>
