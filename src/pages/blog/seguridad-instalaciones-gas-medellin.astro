---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/organisms/Header.astro';
import Footer from '../../components/organisms/Footer.astro';
import CTASection from '../../components/organisms/CTASection.astro';
import EyebrowLabel from '../../components/atoms/EyebrowLabel.astro';
import Button from '../../components/atoms/Button.astro';
import WhatsAppIcon from '../../components/atoms/WhatsAppIcon.astro';
import { getCollection } from 'astro:content';
import { WHATSAPP_URL } from '../../lib/constants';

const allPosts = await getCollection('blog');
const articles = allPosts.filter(p => p.data.pillar === 1).sort((a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime());

const pillarSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guía de Seguridad en Instalaciones de Gas en Medellín',
  description: 'Aprende a prevenir fugas, conoce la normativa NTC 2505 y protege tu hogar. Guía completa de seguridad en instalaciones de gas en Medellín.',
  url: 'https://lujogas.com.co/blog/seguridad-instalaciones-gas-medellin',
  inLanguage: 'es-CO',
  author: { '@type': 'Person', name: 'Luis Guillermo Muñoz Vélez' },
  publisher: { '@type': 'Organization', name: 'LujoGas', url: 'https://lujogas.com.co' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.data.title,
      url: `https://lujogas.com.co/blog/${a.slug}`,
    })),
  },
};

// FAQ propia del pilar: el hub quedaba por debajo de las 600 palabras y su único
// contenido era el listado del clúster, insuficiente para indexar por sí solo.
const faq = [
  {
    q: "¿Cuáles son los riesgos reales de una instalación de gas sin certificar?",
    a: "Tres, y ninguno es teórico. Fuga por uniones mal ejecutadas o material no apto, que puede acumular gas en espacios cerrados. Intoxicación por monóxido de carbono cuando la ventilación es insuficiente y la combustión queda incompleta. Y suspensión del servicio por parte de la distribuidora, que exige el certificado vigente para mantenerlo activo.",
  },
  {
    q: "¿Qué exige la NTC 2505 en materia de ventilación?",
    a: "Que el espacio donde opera un gasodoméstico tenga entrada de aire para la combustión y salida para los gases producidos. En la práctica esto se traduce en rejillas de ventilación con dimensiones definidas y, para calentadores, ducto de evacuación al exterior. Tapar esas rejillas al remodelar es uno de los hallazgos más frecuentes en Medellín.",
  },
  {
    q: "¿El monóxido de carbono se huele?",
    a: "No. El monóxido de carbono es inodoro, incoloro y no irrita, y esa es exactamente la razón por la que es peligroso. Lo que sí se ve es su causa: llama amarilla o anaranjada en vez de azul, y hollín negro alrededor de las ollas o en la pared sobre la estufa. Ante cualquiera de esas señales, ventila y haz revisar la instalación.",
  },
  {
    q: "¿Qué materiales admite la norma para gas?",
    a: "Cobre rígido tipo L y tipo K, acero galvanizado o negro según la aplicación, CPVC certificado específicamente para gas combustible y polietileno de alta densidad para tramos enterrados. Todos deben llevar sello de conformidad NTC. El CPVC común de plomería de agua no sirve para gas y es causa de rechazo frecuente.",
  },
  {
    q: "¿Cada cuánto debo revisar la instalación de mi casa?",
    a: "La Revisión Periódica Obligatoria se hace cada cinco años y es exigida por la reglamentación nacional. Entre una y otra conviene una inspección visual anual, y siempre después de una remodelación, un cambio de gasodoméstico o cualquier trabajo que haya tocado la tubería.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'LujoGas', item: 'https://lujogas.com.co/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://lujogas.com.co/blog' },
    { '@type': 'ListItem', position: 3, name: pillarSchema.name, item: pillarSchema.url },
  ],
};
---

<BaseLayout
  title="Guía de Seguridad en Instalaciones de Gas Medellín | LujoGas"
  description="Guía de seguridad en instalaciones de gas en Medellín: normativa NTC 2505, prevención de fugas y materiales certificados. Consejos de técnico experto."
  canonical="https://lujogas.com.co/blog/seguridad-instalaciones-gas-medellin"
>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(pillarSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main>
    <section class="relative bg-hero-bg overflow-hidden pt-[140px] pb-[80px] md:pt-[160px] md:pb-[100px]">
      <div class="pipes-bg" />
      <div class="container-section relative z-10">
        <nav class="flex items-center gap-2 text-sm text-hero-text/60 mb-6">
          <a href="/" class="hover:text-blue-bright transition-colors">Inicio</a>
          <span>/</span>
          <a href="/blog" class="hover:text-blue-bright transition-colors">Blog</a>
          <span>/</span>
          <span class="text-hero-text/40">Seguridad</span>
        </nav>
        <EyebrowLabel text="Pilar de Contenido" class="mb-2" />
        <h1 class="font-display text-4xl md:text-6xl lg:text-7xl text-background leading-[0.85] tracking-[-0.02em] uppercase max-w-4xl">
          Guía de Seguridad en <span class="text-tertiary">Instalaciones de Gas</span> en Medellín
        </h1>
        <p class="text-hero-text text-lg md:text-xl max-w-2xl mt-6 leading-relaxed">
          La seguridad de tu hogar empieza por una instalación de gas que cumpla la normativa NTC 2505. En esta guía encontrarás todo lo que necesitas saber para prevenir fugas, elegir materiales certificados y mantener tu red de gas en óptimas condiciones en Medellín y el Valle de Aburrá.
        </p>
      </div>
    </section>

    <section class="section-pad">
      <div class="container-section max-w-[800px]">
        <p class="text-primary/80 text-lg leading-relaxed mb-8">
          En <strong>LujoGas</strong>, liderado por <strong>Luis Guillermo Muñoz Vélez</strong>, técnico certificado NTC 2505 con más de 3.000 certificaciones realizadas en Medellín, sabemos que la seguridad es lo primero. Por eso hemos creado este clúster de contenido para que aprendas a proteger tu hogar.
        </p>
        <p class="text-primary/80 text-lg leading-relaxed mb-8">
          ¿Sospechas una fuga o necesitas revisión urgente? Agenda una <a href="/mantenimiento-gas-medellin" class="text-tertiary font-semibold underline underline-offset-4 hover:text-tertiary/80 transition-colors">revisión de tu red de gas en Medellín</a> con técnico certificado NTC 2505.
        </p>
      </div>
    </section>

    <section class="section-pad bg-surface">
      <div class="container-section">
        <EyebrowLabel text="Artículos del clúster" class="mb-2" />
        <h2 class="font-display text-3xl md:text-4xl text-primary uppercase tracking-[-0.02em] mb-10">
          Todo sobre <span class="text-tertiary">seguridad</span> en gas
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
          {articles.map((article) => (
            <a
              href={`/blog/${article.slug}`}
              class="group bg-background rounded-2xl p-6 border border-neutral/20 hover:border-tertiary/30 hover:-translate-y-1 transition-all duration-300"
            >
              <span class="font-mono text-sm text-tertiary mb-2 block">{article.data.readingTime} min</span>
              <h3 class="font-display text-xl text-primary uppercase leading-tight group-hover:text-tertiary transition-colors">
                {article.data.title}
              </h3>
              <p class="text-muted text-sm mt-3 line-clamp-3">{article.data.description}</p>
              <span class="inline-block mt-4 text-sm font-semibold text-tertiary">Leer artículo →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container-section max-w-[800px]">
        <h2 class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6">
          ¿Por qué es importante la seguridad en el gas?
        </h2>
        <p class="text-primary/80 text-lg leading-relaxed mb-5">
          Una instalación de gas que no cumple la normativa NTC 2505 puede tener consecuencias graves: fugas, explosiones, intoxicación por monóxido de carbono. En Medellín, donde la mayoría de hogares usan gas natural, la seguridad no es opcional.
        </p>
        <p class="text-primary/80 text-lg leading-relaxed mb-5">
          La buena noticia es que la mayoría de los accidentes son prevenibles. Con una instalación certificada, materiales adecuados y mantenimiento periódico, tu red de gas puede operar de forma segura durante décadas.
        </p>

        <h2 class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mt-12 mb-6">
          Consejos clave para tu hogar en Medellín
        </h2>
        <ul class="space-y-4 text-primary/80 text-lg">
          <li class="flex items-start gap-3">
            <span class="text-tertiary mt-1">✓</span>
            <span>Contrata siempre un técnico certificado NTC 2505</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-tertiary mt-1">✓</span>
            <span>Usa exclusivamente materiales con sello ICONTEC</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-tertiary mt-1">✓</span>
            <span>Haz la RPO cada 5 años sin falta</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-tertiary mt-1">✓</span>
            <span>Revisa visualmente tu instalación cada mes</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="text-tertiary mt-1">✓</span>
            <span>Ante cualquier olor a gas, actúa de inmediato</span>
          </li>
        </ul>

        <div class="mt-10 p-8 bg-hero-bg rounded-2xl text-center">
          <p class="font-display text-2xl text-background uppercase">¿Tu instalación de gas está certificada?</p>
          <p class="text-hero-text mt-3">Agenda tu visita diagnóstica por $50.000 y verifica que todo esté en orden.</p>
          <div class="mt-6">
            <Button href={WHATSAPP_URL} variant="whatsapp" size="lg" target="_blank" rel="noopener noreferrer" ariaLabel="Cotizar por WhatsApp">
              <WhatsAppIcon />
              Agendar revisión
            </Button>
          </div>
        </div>
      </div>
    </section>


    <section class="section-pad bg-surface">
      <div class="container-section max-w-[800px]">

        <h2 class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6">
          Los tres riesgos que la norma existe para evitar
        </h2>
        <ul class="flex flex-col gap-4 mb-10">
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Fuga de gas.</strong> Se origina en uniones que pierden ajuste, corrosión en tubería expuesta, mangueras de gasodoméstico vencidas o material no apto. Las señales tempranas —olor a huevo podrido, silbido cerca de la tubería, consumo que sube sin explicación— están detalladas en <a href="/blog/como-detectar-fuga-gas-casa" class="text-tertiary font-semibold underline underline-offset-4">cómo detectar una fuga de gas</a>.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Combustión incompleta.</strong> Cuando el quemador no recibe el aire que necesita, produce monóxido de carbono, que no huele a nada. La causa más común no es la fuga sino la ventilación insuficiente: rejillas tapadas al remodelar, cocinas cerradas sin entrada de aire, ductos de calentador obstruidos.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Instalación ejecutada sin competencia acreditada.</strong> Un punto agregado sin cálculo de caudal, una unión mal sellada o un trazado que pasa por donde la norma no permite. El documento que expida alguien sin credencial no lo acepta la distribuidora, y los hallazgos quedan sin detectar. Cómo verificarlo está en <a href="/empresas-autorizadas-revision-gas-medellin" class="text-tertiary font-semibold underline underline-offset-4">empresas autorizadas para revisión de gas</a>.
          </li>
        </ul>

        <h2 class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6">
          Qué revisa un técnico certificado
        </h2>
        <ul class="flex flex-col gap-4 mb-10">
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Materiales y sello de conformidad.</strong> Que cada tramo use material apto para gas combustible y no un sustituto de plomería de agua.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Ventilación y evacuación.</strong> Entrada de aire para la combustión, salida para los gases, y ducto al exterior donde el gasodoméstico lo requiera.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Distancias de seguridad.</strong> Separación entre la tubería de gas y instalaciones eléctricas, y respecto a fuentes de calor.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Reguladores y válvulas.</strong> Estado, vigencia y accesibilidad de la llave de paso, que debe poder cerrarse sin forzarla.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Hermeticidad.</strong> La prueba con manómetro que verifica que la red mantiene presión. Es la que respalda el <a href="/certificacion-gas-medellin" class="text-tertiary font-semibold underline underline-offset-4">certificado</a>.
          </li>
        </ul>

        <p class="text-primary/80 text-lg leading-relaxed mb-10">
          Si hueles gas ahora mismo, no sigas leyendo: sal del inmueble y llama a EPM al (604) 44 44 115 o al 123. El protocolo completo está en <a href="/blog/que-hacer-si-huele-gas-casa-emergencia" class="text-tertiary font-semibold underline underline-offset-4">qué hacer si huele a gas en casa</a>.
        </p>

        <h2 class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6">
          Preguntas frecuentes
        </h2>
        <div class="flex flex-col gap-4">
          {faq.map((f) => (
            <details class="group border border-neutral/15 rounded-2xl overflow-hidden bg-background">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-display font-semibold text-primary text-[16px] leading-snug list-none">
                {f.q}
                <svg class="flex-shrink-0 transition-transform duration-200 group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <div class="px-6 pb-5 text-muted text-[14.5px] leading-relaxed border-t border-neutral/10 pt-4">
                {f.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />
</BaseLayout>

<script>
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el.classList.add('in');
    } else {
      io.observe(el);
    }
  });
</script>
