---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/organisms/Header.astro';
import Footer from '../../components/organisms/Footer.astro';
import CTASection from '../../components/organisms/CTASection.astro';
import EyebrowLabel from '../../components/atoms/EyebrowLabel.astro';
import Button from '../../components/atoms/Button.astro';
import WhatsAppIcon from '../../components/atoms/WhatsAppIcon.astro';
import { getCollection } from 'astro:content';
import { WHATSAPP_URL } from '../../lib/constants';

const allPosts = await getCollection('blog');
const articles = allPosts
  .filter((p) => p.data.pillar === 4)
  .sort((a, b) => a.data.publishDate.getTime() - b.data.publishDate.getTime());

const pillarSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Guía de Mantenimiento de Redes de Gas en Medellín',
  description:
    'Guía completa de mantenimiento de gas en Medellín: preventivo, correctivo, RPO, señales de alerta y emergencias.',
  url: 'https://lujogas.com.co/blog/mantenimiento-redes-gas-medellin',
  inLanguage: 'es-CO',
  author: { '@type': 'Person', name: 'Luis Guillermo Muñoz Vélez' },
  publisher: {
    '@type': 'Organization',
    name: 'LujoGas',
    url: 'https://lujogas.com.co',
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((a, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: a.data.title,
      url: `https://lujogas.com.co/blog/${a.slug}`,
    })),
  },
};

// FAQ propia del pilar: el hub quedaba por debajo de las 600 palabras y su único
// contenido era el listado del clúster, insuficiente para indexar por sí solo.
const faq = [
  {
    q: '¿Qué diferencia hay entre mantenimiento preventivo y RPO?',
    a: 'La Revisión Periódica Obligatoria es un requisito legal cada cinco años, termina en un certificado y la exige la distribuidora. El mantenimiento preventivo es voluntario, se hace con más frecuencia y su objetivo es encontrar desgaste antes de que se vuelva hallazgo o falla. Uno no reemplaza al otro: el preventivo hace que la RPO salga limpia.',
  },
  {
    q: '¿Cada cuánto conviene hacer mantenimiento preventivo?',
    a: 'Una vez al año para una instalación residencial en uso normal, y siempre después de una remodelación que haya tocado la tubería o de un cambio de gasodoméstico. En instalaciones comerciales con cocina de uso continuo, la frecuencia razonable es mayor por la carga de trabajo de los equipos.',
  },
  {
    q: '¿Qué incluye el mantenimiento de una red de gas?',
    a: 'Revisión del trazado completo, verificación de materiales y uniones, estado de reguladores y válvulas, limpieza y ajuste de quemadores, comprobación de ventilación y ductos de evacuación, y prueba de hermeticidad. Al terminar se entrega el reporte de lo verificado y lo corregido.',
  },
  {
    q: '¿Cuánto cuesta el mantenimiento de gas en Medellín?',
    a: 'La visita diagnóstica cuesta $50.000, descontable si contratas el servicio. El valor del mantenimiento depende de lo que encuentre la revisión, y se presupuesta antes de intervenir. Si además se requiere certificación, esta parte de $150.000.',
  },
  {
    q: '¿El mantenimiento evita que me suspendan el servicio?',
    a: 'Indirectamente sí. Lo que evita la suspensión es presentar el certificado de la revisión periódica dentro del plazo que EPM notifica en la factura. El mantenimiento hace que esa revisión no encuentre hallazgos que obliguen a corregir de urgencia y a pagar dos veces.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'LujoGas', item: 'https://lujogas.com.co/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://lujogas.com.co/blog' },
    { '@type': 'ListItem', position: 3, name: pillarSchema.name, item: pillarSchema.url },
  ],
};
---

<BaseLayout
  title="Guía de Mantenimiento de Redes de Gas en Medellín | LujoGas"
  description="Guía de mantenimiento de redes de gas en Medellín: preventivo, correctivo, RPO, señales de alerta y emergencias. Consejos de técnico certificado NTC 2505."
  canonical="https://lujogas.com.co/blog/mantenimiento-redes-gas-medellin"
>
  <Header />
  <script type="application/ld+json" set:html={JSON.stringify(pillarSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main>
    <section
      class="relative bg-hero-bg overflow-hidden pt-[140px] pb-[80px] md:pt-[160px] md:pb-[100px]"
    >
      <div class="pipes-bg"></div>
      <div class="container-section relative z-10">
        <nav class="flex items-center gap-2 text-sm text-hero-text/60 mb-6">
          <a href="/" class="hover:text-blue-bright transition-colors">Inicio</a
          >
          <span>/</span>
          <a href="/blog" class="hover:text-blue-bright transition-colors"
            >Blog</a
          >
          <span>/</span>
          <span class="text-hero-text/40">Mantenimiento</span>
        </nav>
        <EyebrowLabel text="Pilar de Contenido" class="mb-2" />
        <h1
          class="font-display text-4xl md:text-6xl lg:text-7xl text-background leading-[0.85] tracking-[-0.02em] uppercase max-w-4xl"
        >
          Guía de Mantenimiento y <span class="text-tertiary">Cuidado</span> de Redes
          de Gas en Medellín
        </h1>
        <p
          class="text-hero-text text-lg md:text-xl max-w-2xl mt-6 leading-relaxed"
        >
          El mantenimiento regular de tu red de gas es la mejor inversión que
          puedes hacer para proteger tu hogar. En esta guía encontrarás consejos
          prácticos de cuidado, señales de alerta, protocolos de emergencia y
          todo lo que necesitas saber para mantener tu instalación en perfecto
          estado.
        </p>
      </div>
    </section>

    <section class="section-pad">
      <div class="container-section max-w-[800px]">
        <p class="text-primary/80 text-lg leading-relaxed mb-8">
          En <strong>LujoGas</strong> sabemos que una instalación de gas bien mantenida
          puede durar décadas sin problemas. Por eso hemos creado este clúster con
          información práctica que te ayudará a detectar problemas a tiempo y saber
          cuándo llamar a un técnico certificado NTC 2505.
        </p>
        <p class="text-primary/80 text-lg leading-relaxed mb-8">
          ¿Tu red ya necesita revisión? Agenda directo nuestro servicio de <a
            href="/mantenimiento-gas-medellin"
            class="text-tertiary font-semibold underline underline-offset-4 hover:text-tertiary/80 transition-colors"
            >mantenimiento de gas en Medellín</a
          > — preventivo, correctivo y RPO.
        </p>
      </div>
    </section>

    <section class="section-pad bg-surface">
      <div class="container-section">
        <EyebrowLabel text="Artículos del clúster" class="mb-2" />
        <h2
          class="font-display text-3xl md:text-4xl text-primary uppercase tracking-[-0.02em] mb-10"
        >
          Todo sobre <span class="text-tertiary">mantenimiento</span> de gas
        </h2>
        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger"
        >
          {
            articles.map((article) => (
              <a
                href={`/blog/${article.slug}`}
                class="group bg-background rounded-2xl p-6 border border-neutral/20 hover:border-tertiary/30 hover:-translate-y-1 transition-all duration-300"
              >
                <span class="font-mono text-sm text-tertiary mb-2 block">
                  {article.data.readingTime} min
                </span>
                <h3 class="font-display text-xl text-primary uppercase leading-tight group-hover:text-tertiary transition-colors">
                  {article.data.title}
                </h3>
                <p class="text-muted text-sm mt-3 line-clamp-3">
                  {article.data.description}
                </p>
                <span class="inline-block mt-4 text-sm font-semibold text-tertiary">
                  Leer artículo →
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container-section max-w-[800px]">
        <h2
          class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6"
        >
          ¿Cada cuánto dar mantenimiento a tu red de gas?
        </h2>
        <p class="text-primary/80 text-lg leading-relaxed mb-5">
          La normativa colombiana exige la RPO cada 5 años, pero el
          mantenimiento preventivo recomendado es anual. En Medellín, donde el
          clima puede acelerar la corrosión en zonas húmedas, una revisión anual
          puede detectar problemas antes de que se conviertan en emergencias.
        </p>
        <p class="text-primary/80 text-lg leading-relaxed mb-5">
          Además del mantenimiento profesional, hay pequeñas cosas que puedes
          hacer tú mismo: revisar visualmente las tuberías, verificar que las
          llamas sean azules y estables, y estar atento a cualquier olor
          extraño.
        </p>
      </div>
    </section>

    <section class="section-pad bg-surface">
      <div class="container-section max-w-[800px]">
        <h2
          class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6"
        >
          Preventivo, correctivo y obligatorio: qué es cada uno
        </h2>
        <ul class="flex flex-col gap-4 mb-10">
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Preventivo.</strong> Programado, anual, busca
            desgaste antes de que falle. Incluye limpieza de quemadores, revisión
            de uniones, estado de reguladores y verificación de ventilación. Detalle
            completo en <a
              href="/blog/mantenimiento-preventivo-gas-cada-cuando"
              class="text-tertiary font-semibold underline underline-offset-4"
              >cada cuánto hacer mantenimiento preventivo</a
            >.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Correctivo.</strong> Responde a un problema
            ya presente: una fuga localizada, un regulador que falla, un calentador
            que no enciende. No es opcional cuando aparece, y conviene atenderlo antes
            de que crezca.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Revisión Periódica Obligatoria.</strong
            > Exigida por la reglamentación cada cinco años, termina en certificado
            y la notifica EPM en la factura. Es la única de las tres que tiene consecuencia
            legal directa: sin ella, la distribuidora puede suspender el servicio.
          </li>
        </ul>

        <h2
          class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6"
        >
          Señales de que tu red necesita mantenimiento ya
        </h2>
        <ul class="flex flex-col gap-4 mb-10">
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Llama amarilla o anaranjada.</strong> La
            llama sana es azul y estable. El color indica combustión incompleta, casi
            siempre por quemador sucio o ventilación insuficiente.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Olor intermitente a gas.</strong> Aparece
            y se va. Suele ser una unión que pierde ajuste con la dilatación térmica,
            y es la antesala de una fuga franca.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary"
              >Consumo que sube sin cambio de hábitos.</strong
            > Un escape pequeño y constante no se oye ni se huele con claridad, pero
            sí se cobra. Otras causas en <a
              href="/blog/factura-gas-epm-alta-causas-soluciones"
              class="text-tertiary font-semibold underline underline-offset-4"
              >factura de gas alta</a
            >.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary"
              >Hollín alrededor de ollas o en la pared.</strong
            > Residuo de combustión incompleta. Indica que el equipo no está recibiendo
            el aire que necesita.
          </li>
          <li class="text-primary/80 text-[16px] leading-relaxed">
            <strong class="text-primary">Llave de paso que cuesta girar.</strong
            > Una válvula trabada es un problema el día que haya que cerrarla con
            urgencia.
          </li>
        </ul>

        <p class="text-primary/80 text-lg leading-relaxed mb-10">
          Si reconociste alguna de estas señales, la revisión no debería esperar
          a la próxima RPO. Agenda la <a
            href="/mantenimiento-gas-medellin"
            class="text-tertiary font-semibold underline underline-offset-4"
            >visita de mantenimiento</a
          > y, si la instalación cumple, el certificado se entrega en 24 a 48 horas
          hábiles.
        </p>

        <h2
          class="font-display text-3xl text-primary uppercase tracking-[-0.02em] mb-6"
        >
          Preguntas frecuentes
        </h2>
        <div class="flex flex-col gap-4">
          {
            faq.map((f) => (
              <details class="group border border-neutral/15 rounded-2xl overflow-hidden bg-background">
                <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-display font-semibold text-primary text-[16px] leading-snug list-none">
                  {f.q}
                  <svg
                    class="flex-shrink-0 transition-transform duration-200 group-open:rotate-180"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    aria-hidden="true"
                  >
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </summary>
                <div class="px-6 pb-5 text-muted text-[14.5px] leading-relaxed border-t border-neutral/10 pt-4">
                  {f.a}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />
</BaseLayout>

<script>
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('in');
          io.unobserve(e.target);
        }
      }),
    { threshold: 0.08 },
  );
  document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => {
    const rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight) {
      el.classList.add('in');
    } else {
      io.observe(el);
    }
  });
</script>
