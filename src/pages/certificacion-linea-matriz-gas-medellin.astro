---
/**
 * Landing B2B: certificación de líneas matrices de gas en conjuntos y edificios.
 * El precio no se publica: depende del número de apartamentos y se cotiza.
 * El plazo de entrega tampoco se promete: varía con el tamaño de la unidad.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import CTASection from '../components/organisms/CTASection.astro';
import EyebrowLabel from '../components/atoms/EyebrowLabel.astro';
import { WHATSAPP_NUMBER, SITE } from '../lib/constants';
import { zonas } from '../data/zonas';

const canonical = 'https://lujogas.com.co/certificacion-linea-matriz-gas-medellin';
const pageTitle = 'Certificación Línea Matriz de Gas en Medellín | LujoGas';
const pageDesc =
  'Certificación de línea matriz de gas para conjuntos y edificios en Medellín. Revisión cada 5 años, informe a la administración y corrección de hallazgos.';

const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  'Hola LujoGas, quiero cotizar la certificación de la línea matriz de gas de una unidad residencial en Medellín. Número de apartamentos: ',
)}`;

const alcance = [
  {
    title: 'Recorrido de la tubería',
    desc: 'Revisamos la línea matriz en todo su trayecto visible: fachadas, ductos, sótanos, parqueaderos y cuartos técnicos. Buscamos corrosión, golpes, uniones deterioradas y tramos sin protección.',
  },
  {
    title: 'Prueba de hermeticidad',
    desc: 'Es la prueba que exige el reglamento técnico para las edificaciones multifamiliares. Confirma que la línea matriz no tiene escapes, incluso los que no se perciben con el olfato.',
  },
  {
    title: 'Centros de medición',
    desc: 'Verificamos medidores, reguladores y válvulas de cada apartamento, y medimos presencia de gas en las conexiones. Concentra las conexiones de todos los apartamentos, así que un escape ahí afecta a muchos usuarios a la vez.',
  },
  {
    title: 'Válvulas de corte',
    desc: 'Comprobamos que la válvula de corte general de la edificación y las de cada sector abran, cierren y sean accesibles. En una emergencia, son lo primero que se necesita.',
  },
  {
    title: 'Soportes y protección',
    desc: 'Anclajes, abrazaderas y protección mecánica de la tubería en zonas de tránsito vehicular o peatonal, donde un golpe puede comprometer toda la red del conjunto.',
  },
  {
    title: 'Ventilación y señalización',
    desc: 'Ventilación de los recintos donde están los medidores e identificación de la tubería de gas, para que nadie la confunda durante una reparación de otro tipo.',
  },
];

const pasos = [
  {
    n: '1',
    title: 'La administración nos escribe',
    desc: 'Por WhatsApp, con el número de apartamentos, torres, dirección del conjunto y, si la tienen, la fecha del último certificado de la línea matriz.',
  },
  {
    n: '2',
    title: 'Cotización por número de apartamentos',
    desc: 'El valor depende del tamaño de la unidad. Con los datos enviamos la cotización para que la administración o el consejo la aprueben.',
  },
  {
    n: '3',
    title: 'Visita coordinada',
    desc: 'Programamos la inspección con la administración para avisar a los residentes con tiempo. El trabajo se hace en zonas comunes y centros de medición.',
  },
  {
    n: '4',
    title: 'Certificado o informe de hallazgos',
    desc: 'Si la línea matriz cumple, se expide el certificado. Si no, la administración recibe un informe escrito con cada hallazgo, dónde está y qué exige la norma para corregirlo.',
  },
  {
    n: '5',
    title: 'Corrección y cierre',
    desc: 'La administración decide quién corrige. Si nos elige, presupuestamos las correcciones antes de intervenir, las ejecutamos y verificamos de nuevo para emitir el certificado.',
  },
];

const tiposEdificacion = [
  {
    title: 'Conjuntos y unidades residenciales',
    desc: 'Unidades cerradas con varias torres o casas, portería y red de gas que recorre zonas comunes hasta los medidores.',
  },
  {
    title: 'Edificios de apartamentos',
    desc: 'Edificios en propiedad horizontal, aunque no sean conjunto cerrado, con centro de medición compartido.',
  },
  {
    title: 'Edificios comerciales',
    desc: 'Centros comerciales, edificios de oficinas y locales con línea matriz que alimenta a varios usuarios.',
  },
  {
    title: 'Constructoras y obra nueva',
    desc: 'Proyectos que requieren línea matriz y deben certificarla antes de que la distribuidora conecte el servicio.',
  },
];

const faq = [
  {
    q: '¿Qué es la línea matriz de gas de un conjunto residencial?',
    a: 'Es la tubería de gas que va por las zonas comunes de la edificación, desde la válvula de corte de la acometida hasta los medidores de cada apartamento. Así la define la Resolución 90902 de 2013 del Ministerio de Minas y Energía. Lo que va del medidor hacia adentro del apartamento es la línea individual, que es responsabilidad de cada propietario.',
  },
  {
    q: '¿Quién paga la certificación de la línea matriz?',
    a: 'La copropiedad, a través de la administración. La línea matriz está en zonas comunes y es un bien común, y la Ley 675 de 2001 asigna al administrador la función de cuidar y vigilar los bienes comunes. La revisión de cada apartamento, en cambio, la paga cada propietario.',
  },
  {
    q: '¿Cada cuánto hay que certificar la línea matriz de gas?',
    a: 'Cada cinco años, igual que la red interna de los apartamentos, según la Resolución CREG 059 de 2012. El plazo máximo vence el último día hábil del mes en que se cumplen los cinco años desde la última revisión, y la nueva revisión puede hacerse desde cinco meses antes de esa fecha.',
  },
  {
    q: '¿Cuánto cuesta certificar la línea matriz en Medellín?',
    a: 'Depende de cuántos apartamentos tiene la unidad residencial, y en menor medida del número de torres y centros de medición. Por eso no manejamos un precio único: la administración nos escribe por WhatsApp con el número de apartamentos y enviamos la cotización.',
  },
  {
    q: '¿Qué pasa si la revisión encuentra hallazgos?',
    a: 'Se informan por escrito a la administración para que los corrija. Si el hallazgo es un defecto crítico, como una fuga, el reglamento exige corregirlo de inmediato o suspender el servicio. Si es un defecto no crítico, la distribuidora fija un plazo de corrección que no puede superar dos meses. LujoGas puede presupuestar y ejecutar las correcciones si la administración lo decide.',
  },
  {
    q: '¿La certificación de la línea matriz reemplaza la revisión de cada apartamento?',
    a: 'No. Son dos revisiones distintas. La de la línea matriz cubre la tubería común hasta los medidores y se hace una sola vez por periodo para todo el conjunto. La de cada apartamento cubre la red desde su medidor hasta los gasodomésticos y la contrata cada propietario.',
  },
  {
    q: '¿Quién está autorizado para certificar la línea matriz?',
    a: 'Según EPM, la revisión periódica de la línea matriz la certifican organismos de inspección acreditados ante el ONAC e inscritos ante la distribuidora. En LujoGas la ejecuta un técnico con certificado de competencia laboral NTC 2505, respaldado por un organismo de inspección acreditado.',
  },
  {
    q: '¿Cuánto tarda la certificación de la línea matriz?',
    a: 'Depende del tamaño de la unidad: no es lo mismo un edificio de 12 apartamentos que un conjunto de varias torres. El cronograma se acuerda con la administración al aprobar la cotización, y se coordina con los residentes para afectar lo menos posible el uso del gas.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Certificación de línea matriz de gas en Medellín',
  serviceType: 'Certificación de línea matriz de gas',
  description:
    'Revisión periódica y certificación de líneas matrices de gas en conjuntos residenciales, edificios y centros comerciales de Medellín y el Valle de Aburrá. Informe de hallazgos a la administración y corrección opcional.',
  provider: {
    '@type': 'LocalBusiness',
    '@id': 'https://lujogas.com.co/#localbusiness',
    name: SITE.name,
    telephone: SITE.phone,
    url: 'https://lujogas.com.co',
  },
  areaServed: zonas.map((z) => ({ '@type': 'Place', name: `${z.name}, ${z.municipio}` })),
  audience: {
    '@type': 'BusinessAudience',
    audienceType:
      'Administraciones de propiedad horizontal, conjuntos residenciales, edificios y constructoras',
  },
  url: canonical,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://lujogas.com.co/' },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: 'https://lujogas.com.co/servicios' },
    { '@type': 'ListItem', position: 3, name: 'Certificación de línea matriz de gas', item: canonical },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const linkClass = 'font-semibold text-tertiary underline underline-offset-2 hover:opacity-80';
---

<BaseLayout title={pageTitle} description={pageDesc} canonical={canonical}>
  <Header />

  <main>
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- ── Hero ───────────────────────────────────────────────────────── -->
    <section class="relative overflow-hidden bg-[#333333] pt-[140px] pb-[80px]" aria-labelledby="hero-heading">
      <div class="pipes-bg" aria-hidden="true"></div>
      <div class="container-section relative z-10">
        <nav aria-label="Ruta de navegación" class="mb-6">
          <ol class="flex flex-wrap items-center gap-2 text-[12px] text-neutral/50 font-mono tracking-wide">
            <li><a href="/" class="hover:text-neutral/80 transition-colors">Inicio</a></li>
            <li aria-hidden="true" class="text-neutral/30">/</li>
            <li><a href="/servicios" class="hover:text-neutral/80 transition-colors">Servicios</a></li>
            <li aria-hidden="true" class="text-neutral/30">/</li>
            <li class="text-neutral/70">Línea matriz</li>
          </ol>
        </nav>

        <div class="max-w-[800px]">
          <div class="flex items-center gap-3 mb-5">
            <span class="block w-8 h-px bg-tertiary"></span>
            <span class="font-mono text-[11px] font-semibold tracking-[0.26em] uppercase text-tertiary">
              Conjuntos · Edificios · Propiedad horizontal
            </span>
          </div>

          <h1
            id="hero-heading"
            class="font-display font-semibold leading-[0.97] tracking-[-0.01em] text-background mb-5 text-[clamp(34px,4.6vw,64px)] max-w-[20ch]"
          >
            Certificación de línea matriz de gas en Medellín
          </h1>

          <p class="text-neutral/70 max-w-[62ch] mb-4 text-[clamp(15px,1.3vw,17px)] leading-[1.65]">
            Certificamos la línea matriz de gas de conjuntos residenciales, edificios y centros
            comerciales en Medellín y el Valle de Aburrá. Es la tubería que recorre las zonas comunes
            hasta los medidores, y debe revisarse cada cinco años. Esa obligación es de la copropiedad,
            no de cada propietario.
          </p>
          <p class="text-neutral/70 max-w-[62ch] mb-8 text-[clamp(15px,1.3vw,17px)] leading-[1.65]">
            El valor depende del número de apartamentos. Si la revisión encuentra hallazgos, se los
            informamos por escrito a la administración para que los corrija, y si lo prefieren, los
            corregimos nosotros.
          </p>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={waUrl}
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-semibold text-[15px] bg-whatsapp text-white transition-all duration-200 hover:opacity-90 min-h-[48px]"
              aria-label="Cotizar la certificación de línea matriz por WhatsApp"
              target="_blank"
              rel="noopener noreferrer"
            >
              Cotizar por WhatsApp
            </a>
            <a
              href={`tel:${SITE.phone}`}
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-semibold text-[15px] border border-white/20 text-white/85 transition-all duration-200 hover:border-neutral/40 min-h-[48px]"
            >
              +57 301 474 8653
            </a>
          </div>

          <ul class="flex flex-wrap gap-x-6 gap-y-2 mt-6 text-sm text-neutral/55">
            <li>Cotización según número de apartamentos</li>
            <li>Informe escrito a la administración</li>
            <li>Técnico certificado NTC 2505</li>
          </ul>
        </div>
      </div>
      <div class="absolute bottom-0 left-0 right-0 h-16 pointer-events-none bg-gradient-to-b from-transparent to-background" aria-hidden="true"></div>
    </section>

    <!-- ── Qué es la línea matriz ─────────────────────────────────────── -->
    <section class="section-pad bg-background" aria-labelledby="que-es-heading">
      <div class="container-section">
        <div class="max-w-[760px] mx-auto">
          <EyebrowLabel text="Qué se certifica" />
          <h2 id="que-es-heading" class="font-display font-semibold text-primary mt-3 mb-6 leading-tight text-[clamp(26px,3vw,40px)]">
            Qué es la línea matriz de gas de un conjunto
          </h2>
          <div class="flex flex-col gap-4 text-muted text-[15.5px] leading-relaxed">
            <p>
              La <a href="https://gestornormativo.creg.gov.co/gestor/entorno/docs/resolucion_minminas_90902_2013.htm" class={linkClass} target="_blank" rel="noopener">Resolución 90902 de 2013</a>,
              el reglamento técnico de instalaciones internas de gas, define la línea matriz como el
              sistema de tuberías <strong class="text-primary">ubicado en las áreas comunes</strong> de
              una edificación multiusuario, comprendido entre la <strong class="text-primary">salida de la
              válvula de corte de la acometida</strong> y los <strong class="text-primary">medidores
              individuales</strong> de cada usuario.
            </p>
            <p>
              Dicho en términos de un conjunto residencial: el gas llega de la red de EPM a la acometida,
              pasa por la válvula de corte general, recorre sótanos, fachadas o ductos (esa es la línea
              matriz) y termina en los centros de medición. Del medidor hacia adentro empieza la línea
              individual de cada apartamento, que revisa y paga cada propietario en su
              <a href="/rpo-gas-medellin" class={linkClass}>revisión periódica obligatoria</a>.
            </p>
            <p>
              Por eso un conjunto puede tener todos los apartamentos al día y aun así la línea matriz
              vencida. Son dos certificados distintos, con responsables distintos.
            </p>
          </div>

          <div class="mt-8 overflow-x-auto rounded-2xl border border-neutral/15 bg-surface">
            <table class="w-full text-left text-[13px] md:text-[14px]">
              <caption class="sr-only">Diferencias entre la línea matriz y la línea individual de gas</caption>
              <thead class="bg-primary text-background">
                <tr>
                  <th scope="col" class="px-2 md:px-4 py-3 font-semibold"></th>
                  <th scope="col" class="px-2 md:px-4 py-3 font-semibold">Línea matriz</th>
                  <th scope="col" class="px-2 md:px-4 py-3 font-semibold">Línea individual</th>
                </tr>
              </thead>
              <tbody class="text-muted divide-y divide-neutral/15">
                <tr>
                  <th scope="row" class="px-2 md:px-4 py-3 font-semibold text-primary">Dónde está</th>
                  <td class="px-2 md:px-4 py-3">Zonas comunes, de la acometida a los medidores</td>
                  <td class="px-2 md:px-4 py-3">Del medidor a los gasodomésticos del apartamento</td>
                </tr>
                <tr>
                  <th scope="row" class="px-2 md:px-4 py-3 font-semibold text-primary">Quién responde</th>
                  <td class="px-2 md:px-4 py-3">La copropiedad, a través de la administración</td>
                  <td class="px-2 md:px-4 py-3">El propietario o usuario de cada unidad</td>
                </tr>
                <tr>
                  <th scope="row" class="px-2 md:px-4 py-3 font-semibold text-primary">Frecuencia</th>
                  <td class="px-2 md:px-4 py-3">Cada 5 años, una inspección para toda la línea</td>
                  <td class="px-2 md:px-4 py-3">Cada 5 años, una por apartamento</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Por qué es obligatoria ─────────────────────────────────────── -->
    <section class="section-pad bg-bg-alt" aria-labelledby="obligatoria-heading">
      <div class="container-section">
        <div class="max-w-[760px] mx-auto">
          <EyebrowLabel text="Lo que exige la norma" />
          <h2 id="obligatoria-heading" class="font-display font-semibold text-primary mt-3 mb-6 leading-tight text-[clamp(26px,3vw,40px)]">
            Por qué la administración debe certificar la línea matriz
          </h2>
          <div class="flex flex-col gap-4 text-muted text-[15.5px] leading-relaxed">
            <p>
              <a href="https://www.epm.com.co/clientesyusuarios/gas/revisiones-tecnicas-o-periodicas/" class={linkClass} target="_blank" rel="noopener">EPM lo indica de forma expresa</a>:
              la revisión periódica de la línea matriz se hace <strong class="text-primary">cada cinco
              años</strong>, en cumplimiento de la Resolución CREG 059 de 2012. Si el plazo vence sin
              certificado, la distribuidora puede suspender el servicio de forma preventiva, y tanto la
              suspensión como la reconexión tienen costo.
            </p>
            <p>
              La responsabilidad recae en la copropiedad porque la línea matriz es un bien común. La
              <a href="http://www.secretariasenado.gov.co/senado/basedoc/ley_0675_2001_pr001.html" class={linkClass} target="_blank" rel="noopener">Ley 675 de 2001</a>
              asigna al administrador la función de <strong class="text-primary">cuidar y vigilar los
              bienes comunes</strong> (artículo 51) y presume su culpa leve cuando incumple sus funciones
              (artículo 50). Una línea matriz sin revisar es un riesgo de seguridad para todos los
              residentes y un riesgo de responsabilidad para quien administra.
            </p>
            <p>
              El reglamento técnico agrega un detalle que favorece a los conjuntos: cuando una línea
              matriz alimenta a varios usuarios, se inspecciona <strong class="text-primary">una sola
              vez</strong> en el periodo que corresponde, no una vez por apartamento.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Qué revisamos ──────────────────────────────────────────────── -->
    <section class="section-pad bg-background" aria-labelledby="alcance-heading">
      <div class="container-section">
        <div class="text-center mb-12 reveal">
          <EyebrowLabel text="Alcance de la inspección" />
          <h2 id="alcance-heading" class="font-display font-semibold text-primary mt-3 leading-tight text-[clamp(28px,3.5vw,44px)]">
            Qué revisamos en la línea matriz
          </h2>
          <p class="text-muted mt-4 max-w-[56ch] mx-auto text-[15px] leading-relaxed">
            La inspección sigue el procedimiento de la Resolución 90902 de 2013 y la
            <a href="/blog/ntc-2505-norma-colombiana-instalaciones-gas" class={linkClass}>NTC 2505</a>.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">
          {alcance.map((a) => (
            <div class="border border-neutral/15 rounded-2xl px-6 py-5 bg-surface">
              <h3 class="font-display font-semibold text-primary text-[17px] mb-2 leading-snug">{a.title}</h3>
              <p class="text-muted text-[14.5px] leading-relaxed">{a.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Hallazgos ──────────────────────────────────────────────────── -->
    <section class="section-pad bg-bg-alt" aria-labelledby="hallazgos-heading">
      <div class="container-section">
        <div class="max-w-[760px] mx-auto">
          <EyebrowLabel text="Si algo no cumple" />
          <h2 id="hallazgos-heading" class="font-display font-semibold text-primary mt-3 mb-6 leading-tight text-[clamp(26px,3vw,40px)]">
            Qué pasa cuando la revisión encuentra hallazgos
          </h2>
          <div class="flex flex-col gap-4 text-muted text-[15.5px] leading-relaxed">
            <p>
              Ningún hallazgo queda en una conversación de pasillo. La administración recibe un
              <strong class="text-primary">informe escrito</strong> con cada punto que no cumple, dónde
              está y qué exige la norma para corregirlo, para que lo lleve al consejo o a la asamblea
              con información concreta.
            </p>
            <p>
              El reglamento técnico separa los hallazgos en dos niveles, y de eso depende la urgencia:
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-6">
            <div class="rounded-2xl border border-tertiary/30 bg-surface px-6 py-5">
              <h3 class="font-display font-semibold text-primary text-[17px] mb-2">Defecto crítico</h3>
              <p class="text-muted text-[14.5px] leading-relaxed">
                Por ejemplo, una fuga en la línea matriz o en un centro de medición. Se corrige de
                inmediato durante la visita o, si no es posible, la distribuidora suspende el servicio
                hasta que se demuestre la corrección.
              </p>
            </div>
            <div class="rounded-2xl border border-neutral/20 bg-surface px-6 py-5">
              <h3 class="font-display font-semibold text-primary text-[17px] mb-2">Defecto no crítico</h3>
              <p class="text-muted text-[14.5px] leading-relaxed">
                La red puede seguir en servicio, pero la distribuidora fija un plazo de corrección que
                no puede superar dos meses. Si vence sin corregir, suspende el servicio.
              </p>
            </div>
          </div>
          <p class="text-muted text-[15.5px] leading-relaxed mt-6">
            La administración decide quién hace las correcciones. Si nos elige, las presupuestamos
            antes de intervenir, las ejecutamos con materiales certificados y volvemos a verificar para
            emitir el certificado. Es el mismo enfoque del
            <a href="/mantenimiento-gas-medellin" class={linkClass}>mantenimiento de redes de gas</a>
            que hacemos en viviendas.
          </p>
        </div>
      </div>
    </section>

    <!-- ── Proceso ────────────────────────────────────────────────────── -->
    <section class="section-pad bg-primary relative overflow-hidden" aria-labelledby="proceso-heading">
      <div class="pipes-bg" aria-hidden="true"></div>
      <div class="container-section relative z-10">
        <div class="text-center mb-12 reveal">
          <EyebrowLabel text="Proceso con la administración" />
          <h2 id="proceso-heading" class="font-display font-semibold text-background mt-3 leading-tight text-[clamp(28px,3.5vw,44px)]">
            De la cotización al certificado de la línea matriz
          </h2>
        </div>
        <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5 reveal-stagger">
          {pasos.map((p) => (
            <li class="flex flex-col gap-3 p-6 rounded-2xl border border-neutral/10 bg-background/[0.03]">
              <span class="font-display text-[44px] font-bold leading-none text-secondary/40">{p.n}</span>
              <h3 class="font-display font-semibold text-background text-[17px] leading-snug">{p.title}</h3>
              <p class="text-neutral/60 text-[13.5px] leading-relaxed">{p.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ── Precio ─────────────────────────────────────────────────────── -->
    <section class="section-pad bg-background" aria-labelledby="precio-heading">
      <div class="container-section">
        <div class="max-w-[760px] mx-auto">
          <EyebrowLabel text="Precio" />
          <h2 id="precio-heading" class="font-display font-semibold text-primary mt-3 mb-6 leading-tight text-[clamp(26px,3vw,40px)]">
            Cuánto cuesta certificar la línea matriz de un conjunto
          </h2>
          <div class="flex flex-col gap-4 text-muted text-[15.5px] leading-relaxed">
            <p>
              No hay un precio único porque no hay dos conjuntos iguales. El valor se calcula
              principalmente con el <strong class="text-primary">número de apartamentos</strong>, y lo
              ajustan el número de torres y centros de medición y el recorrido de la tubería.
            </p>
            <p>
              Para cotizar, la administración nos envía por WhatsApp cuántos apartamentos tiene la
              unidad, cuántas torres, la dirección y la fecha del último certificado de la línea
              matriz. Con eso respondemos con un valor cerrado para la revisión. Si aparecen
              correcciones, se presupuestan aparte y siempre antes de tocar la red.
            </p>
          </div>
          <a
            href={waUrl}
            class="inline-flex items-center justify-center gap-2 mt-8 px-6 py-3 rounded-xl font-semibold text-[15px] bg-whatsapp text-white transition-all duration-200 hover:opacity-90 min-h-[48px]"
            aria-label="Solicitar cotización de certificación de línea matriz por WhatsApp"
            target="_blank"
            rel="noopener noreferrer"
          >
            Solicitar cotización
          </a>
        </div>
      </div>
    </section>

    <!-- ── Tipos de edificación ───────────────────────────────────────── -->
    <section class="section-pad bg-bg-alt" aria-labelledby="tipos-heading">
      <div class="container-section">
        <div class="text-center mb-12 reveal">
          <EyebrowLabel text="A quién atendemos" />
          <h2 id="tipos-heading" class="font-display font-semibold text-primary mt-3 leading-tight text-[clamp(28px,3.5vw,44px)]">
            Edificaciones con línea matriz que certificamos
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 reveal-stagger">
          {tiposEdificacion.map((t) => (
            <div class="border border-neutral/15 rounded-2xl px-6 py-5 bg-surface">
              <h3 class="font-display font-semibold text-primary text-[17px] mb-2 leading-snug">{t.title}</h3>
              <p class="text-muted text-[14.5px] leading-relaxed">{t.desc}</p>
            </div>
          ))}
        </div>
        <p class="text-muted text-[15px] leading-relaxed mt-8 max-w-[760px] mx-auto text-center">
          Si se trata de obra nueva, el proceso con EPM incluye viabilidad y revisión del diseño antes
          de la conexión. Lo explicamos en la guía de
          <a href="/blog/gas-natural-obra-nueva-constructor-medellin" class={linkClass}>gas natural en obra nueva</a>.
        </p>
      </div>
    </section>

    <!-- ── Credenciales ───────────────────────────────────────────────── -->
    <section class="section-pad bg-background" aria-labelledby="credencial-heading">
      <div class="container-section">
        <div class="max-w-[760px] mx-auto">
          <EyebrowLabel text="Quién certifica" />
          <h2 id="credencial-heading" class="font-display font-semibold text-primary mt-3 mb-6 leading-tight text-[clamp(26px,3vw,40px)]">
            Técnico certificado, sin intermediarios
          </h2>
          <div class="flex flex-col gap-4 text-muted text-[15.5px] leading-relaxed">
            <p>
              La revisión la hace <strong class="text-primary">Luis Guillermo Muñoz Vélez</strong>,
              técnico con certificado de competencia laboral NTC 2505, respaldado por un organismo de
              inspección acreditado ante el ONAC. Quien evalúa la línea matriz es el mismo que entrega el
              informe y responde las preguntas de la administración. Puedes conocer su trayectoria en
              <a href="/nosotros" class={linkClass}>la página del técnico</a>.
            </p>
            <p>
              Antes de contratar a cualquiera, la administración tiene derecho a pedir esas
              credenciales. Explicamos cómo verificarlas en
              <a href="/empresas-autorizadas-revision-gas-medellin" class={linkClass}>empresas autorizadas para revisión de gas en Medellín</a>,
              y cómo se reparten los papeles entre la distribuidora y el técnico en
              <a href="/blog/quien-certifica-gas-epm-o-tecnico-certificado" class={linkClass}>quién certifica el gas: EPM o un técnico</a>.
            </p>
            <p>
              Si eres administrador y quieres entender el tema antes de llevarlo a asamblea, lee nuestra
              <a href="/blog/linea-matriz-gas-conjuntos-residenciales" class={linkClass}>guía de la línea matriz de gas para administradores</a>.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Cobertura ──────────────────────────────────────────────────── -->
    <section class="section-pad bg-bg-alt" aria-labelledby="cobertura-heading">
      <div class="container-section">
        <div class="text-center mb-10 reveal">
          <EyebrowLabel text="Cobertura" />
          <h2 id="cobertura-heading" class="font-display font-semibold text-primary mt-3 leading-tight text-[clamp(26px,3vw,42px)]">
            Certificación de línea matriz en el Valle de Aburrá
          </h2>
          <p class="text-muted mt-3 max-w-[56ch] mx-auto text-[15px]">
            Atendemos conjuntos y edificios en Medellín, desde El Poblado y Laureles hasta Belén y
            Robledo, y en los municipios del área metropolitana con mayor número de unidades
            residenciales: Envigado, Sabaneta, Itagüí y Bello.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 reveal-stagger">
          {zonas.map((z) => (
            <a
              href={`/instalacion-gas-${z.slug}`}
              class="flex items-center justify-center border border-neutral/15 rounded-xl px-4 py-3 text-[13.5px] font-semibold text-primary bg-surface hover:border-tertiary/40 hover:bg-tertiary/5 transition-all duration-200 text-center min-h-[44px]"
            >
              Gas en {z.name}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ── FAQ ────────────────────────────────────────────────────────── -->
    <section class="section-pad bg-background" aria-labelledby="faq-heading">
      <div class="container-section">
        <div class="text-center mb-10 reveal">
          <EyebrowLabel text="Preguntas frecuentes" />
          <h2 id="faq-heading" class="font-display font-semibold text-primary mt-3 leading-tight text-[clamp(28px,3.5vw,44px)]">
            Preguntas sobre la línea matriz de gas
          </h2>
        </div>
        <div class="max-w-[720px] mx-auto flex flex-col gap-4">
          {faq.map((f) => (
            <details class="group border border-neutral/15 rounded-2xl overflow-hidden bg-surface">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-display font-semibold text-primary text-[16px] leading-snug list-none [&::-webkit-details-marker]:hidden min-h-[44px]">
                {f.q}
                <svg class="flex-shrink-0 transition-transform duration-200 group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              </summary>
              <div class="px-6 pb-5 text-muted text-[14.5px] leading-relaxed border-t border-neutral/10 pt-4">
                {f.a}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTASection showPrice={false} />
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  const io = new IntersectionObserver(
    (entries) => { entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => io.observe(el));
</script>
