                  <p class="text-neutral/55 text-[13.5px] leading-relaxed">{p.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Cobertura ───────────────────────────────────────────────────────── -->
    <section class="section-pad bg-background" aria-labelledby="cobertura-mant-heading">
