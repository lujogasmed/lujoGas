---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import WhatsAppFloat from '../components/react/WhatsAppFloat.tsx';
import { WHATSAPP_URL } from '../lib/constants';

const links = [
  { label: 'Inicio',                   href: '/' },
  { label: 'Servicios de gas',          href: '/servicios' },
  { label: 'Instalación en Medellín',   href: '/instalacion-gas-medellin' },
  { label: 'Certificación de gas',      href: '/certificacion-gas-medellin' },
  { label: 'Mantenimiento de gas',      href: '/mantenimiento-gas-medellin' },
  { label: 'Nosotros',                  href: '/nosotros' },
];
---

<BaseLayout
  title="Página no encontrada | LujoGas"
  description="Esta página no existe. Vuelve al inicio o explora nuestros servicios de instalación, certificación y mantenimiento de gas en Medellín."
>
  <Header />

  <main class="min-h-screen flex items-center justify-center bg-[#060A0D] px-4 py-32 relative overflow-hidden">

    <!-- Glow de fondo -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] rounded-full"
        style="background: radial-gradient(ellipse, rgba(61,127,255,0.12) 0%, transparent 70%);">
      </div>
    </div>

    <div class="relative z-10 text-center max-w-2xl mx-auto w-full">

      <!-- 404 grande y legible -->
      <div class="relative mb-2" aria-hidden="true">
        <span
          class="font-display font-bold leading-none select-none block"
          style="font-size:clamp(120px,22vw,200px); background: linear-gradient(135deg, rgba(106,170,255,0.9) 0%, rgba(61,127,255,0.6) 50%, rgba(61,127,255,0.2) 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;"
        >
          404
        </span>
      </div>

      <!-- Línea separadora -->
      <div class="w-16 h-[2px] mx-auto mb-8 rounded-full" style="background: linear-gradient(to right, rgba(61,127,255,0.6), rgba(106,170,255,0.3));"></div>

      <h1 style="font-family:inherit; font-size:clamp(32px,5vw,52px); font-weight:700; color:#ffffff; line-height:1.15; margin-bottom:16px; letter-spacing:-0.5px;">
        Página no encontrada
      </h1>
      <p style="color:rgba(232,237,245,0.75); font-size:17px; line-height:1.7; margin-bottom:40px; max-width:420px; margin-left:auto; margin-right:auto;">
        La URL que buscas no está disponible. Puede que haya cambiado o que hayas escrito algo diferente.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
        <a
          href="/"
          class="inline-flex items-center gap-2 px-6 py-[14px] rounded-full font-semibold text-[14px] text-white no-underline transition-all duration-150 hover:-translate-y-0.5"
          style="background: rgba(61,127,255,0.2); border: 1px solid rgba(61,127,255,0.4);"
        >
          ← Volver al inicio
        </a>
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-[14px] rounded-full text-white font-bold text-[14px] no-underline transition-all duration-150 hover:-translate-y-0.5"
          style="background: #25D366; box-shadow: 0 4px 24px rgba(37,211,102,0.3);"
          aria-label="Contactar por WhatsApp"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Contáctanos por WhatsApp
        </a>
      </div>

      <!-- Links internos -->
      <div class="border-t pt-8" style="border-color: rgba(255,255,255,0.08);">
        <p style="font-family:monospace; font-size:11px; font-weight:700; letter-spacing:3px; text-transform:uppercase; color:rgba(106,170,255,0.9); margin-bottom:20px;">
          Páginas principales
        </p>
        <nav aria-label="Navegación alternativa" class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {links.map((l) => (
            <a
              href={l.href}
              class="px-4 py-3 rounded-lg text-[13.5px] font-medium no-underline text-center transition-all duration-150"
              style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.1); color: rgba(232,237,245,0.75);"
              onmouseover="this.style.background='rgba(61,127,255,0.12)';this.style.borderColor='rgba(61,127,255,0.4)';this.style.color='#fff';"
              onmouseout="this.style.background='rgba(255,255,255,0.04)';this.style.borderColor='rgba(255,255,255,0.1)';this.style.color='rgba(232,237,245,0.75)';"
            >
              {l.label}
            </a>
          ))}
        </nav>
      </div>

    </div>
  </main>

  <Footer />
  <WhatsAppFloat client:load href={WHATSAPP_URL} />
</BaseLayout>
