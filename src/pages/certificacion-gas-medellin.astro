---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/organisms/Header.astro';
import Footer from '../components/organisms/Footer.astro';
import CTASection from '../components/organisms/CTASection.astro';
import EyebrowLabel from '../components/atoms/EyebrowLabel.astro';
import { zonas } from '../data/zonas';
import { WHATSAPP_NUMBER } from '../lib/constants';

const waText = encodeURIComponent('Hola LujoGas, necesito información sobre certificación de gas en Medellín.');
const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${waText}`;

// ── Schemas ──────────────────────────────────────────────────────────────────
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio",    "item": "https://lujogas.com.co/" },
    { "@type": "ListItem", "position": 2, "name": "Servicios", "item": "https://lujogas.com.co/servicios" },
    { "@type": "ListItem", "position": 3, "name": "Certificación de gas en Medellín", "item": "https://lujogas.com.co/certificacion-gas-medellin" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué es la certificación de gas ICONTEC?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La certificación de gas ICONTEC es un documento oficial emitido por un inspector acreditado que verifica que la instalación de gas cumple con la NTC 2505. Es obligatoria para activar o reactivar el servicio de gas en Colombia.",
      },
    },
    {
      "@type": "Question",
      "name": "¿Cuándo es obligatoria la certificación de gas en Medellín?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Es obligatoria en tres casos: al realizar una instalación nueva de gas, cuando vence la Revisión Periódica Obligatoria (RPO) y cuando se realizan cambios o ampliaciones a la red existente.",
      },
    },
    {
      "@type": "Question",
      "name": "¿Cuánto tarda la certificación de gas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El proceso de inspección se realiza en una visita de 1 a 3 horas según el tamaño de la instalación. El certificado oficial se emite en 24 a 48 horas hábiles tras la aprobación.",
      },
    },
    {
      "@type": "Question",
      "name": "¿Qué pasa si mi instalación no pasa la certificación?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Si la instalación tiene no conformidades, el técnico emite un informe con las correcciones requeridas. LujoGas puede ejecutar esas correcciones y luego proceder con la reinspección para obtener el certificado.",
      },
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta la certificación de gas en Medellín?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La visita diagnóstica tiene un costo de $50.000. El valor de la certificación depende del tamaño de la instalación. Contacta por WhatsApp para obtener información según tu caso específico.",
      },
    },
    {
      "@type": "Question",
      "name": "¿Con qué entidades tiene aval el técnico de LujoGas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Luis Guillermo Muñoz Vélez cuenta con certificación ICONTEC bajo NTC 2505 y aval de EPM / Gas Natural en Antioquia, lo que le permite emitir certificados reconocidos por las distribuidoras de gas en Medellín.",
      },
    },
  ],
};

// ── Cuándo es obligatoria ─────────────────────────────────────────────────────
const cuandoObligatoria = [
  {
    title: 'Instalación nueva de gas',
    desc: 'Siempre que se instale una red de gas nueva en un inmueble, es obligatorio obtener el certificado ICONTEC antes de que la distribuidora (Gas Natural EPM o Surtigas) active el servicio.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9Z"/><path d="M9 22V12h6v10"/></svg>`,
  },
  {
    title: 'RPO vencida',
    desc: 'La Revisión Periódica Obligatoria tiene una vigencia determinada por ley. Cuando esta vence, la distribuidora puede suspender el servicio hasta que se presente un nuevo certificado vigente.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>`,
  },
  {
    title: 'Cambio o ampliación de la red',
    desc: 'Si agregas un nuevo punto de gas, cambias tubería o modificas la instalación existente, la certificación anterior queda sin efecto y debes obtener un nuevo certificado que valide el estado actual.',
    icon: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4Z"/></svg>`,
  },
];

// ── Qué evalúa el técnico ─────────────────────────────────────────────────────
const evaluaciones = [
  { label: 'Estado de la tubería', detail: 'Inspección visual y prueba de tubería de cobre o CPVC: corrosión, dobleces, sujeciones y recorridos según norma.' },
  { label: 'Presiones de trabajo',  detail: 'Verificación de presión estática y de operación en cada punto de consumo según los parámetros NTC 2505.' },
  { label: 'Ventilación de recintos', detail: 'Revisión de área de ventilación mínima en cocinas, cuartos de lavado y espacios donde se ubican calentadores.' },
  { label: 'Accesorios y válvulas', detail: 'Estado de reguladores, válvulas de corte y mangueras. Todos deben ser materiales certificados NTC.' },
  { label: 'Sellos y uniones',      detail: 'Inspección de todas las uniones soldadas o roscadas para verificar hermeticidad, sin fugas perceptibles.' },
  { label: 'Distancias reglamentarias', detail: 'Separaciones entre tubería de gas y otras instalaciones (electricidad, agua) según lo exigido por NTC 2505.' },
];

// ── Proceso de certificación ──────────────────────────────────────────────────
const procesoCert = [
  { n: '1', title: 'Solicitud',         desc: 'Contáctanos por WhatsApp con tu dirección en Medellín. Coordinamos la visita de inspección según tu disponibilidad.' },
  { n: '2', title: 'Inspección técnica', desc: 'El técnico revisa toda la instalación contra los requisitos NTC 2505: tubería, presiones, ventilaciones, válvulas y accesorios.' },
  { n: '3', title: 'Verificación de conformidad', desc: 'Si la instalación cumple todos los requisitos, se documenta el resultado positivo. Si hay no conformidades, se entrega informe con correcciones.' },
  { n: '4', title: 'Entrega del certificado', desc: 'El certificado ICONTEC oficial se emite y entrega en formato físico y digital en 24 a 48 horas hábiles.' },
];
---

<BaseLayout
  title="Certificación de Gas en Medellín ICONTEC | LujoGas"
  description="Certificación de gas en Medellín desde $120.000. Técnico NTC 2505, certificado ICONTEC en 24–48 h. Requerido por EPM. Agenda por WhatsApp."
  canonical="https://lujogas.com.co/certificacion-gas-medellin"
>
  <Header />

  <main>
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <!-- ── Hero ─────────────────────────────────────────────────────────── -->
    <section
      class="relative overflow-hidden pt-[140px] pb-[80px]"
      style="background-color: #333333;"
      aria-labelledby="cert-medellin-heading"
    >
      <div class="pipes-bg" aria-hidden="true"></div>
      <div
        class="absolute inset-0 pointer-events-none"
        style="background: radial-gradient(ellipse 70% 80% at 10% 50%, rgba(37,99,235,0.12) 0%, transparent 65%);"
        aria-hidden="true"
      ></div>

      <div class="container-section relative z-10">
        <nav aria-label="Ruta de navegación" class="mb-6">
          <ol class="flex items-center gap-2 text-[12px] text-neutral/50 font-mono tracking-wide">
            <li><a href="/" class="hover:text-neutral/80 transition-colors">Inicio</a></li>
            <li aria-hidden="true" class="text-neutral/30">/</li>
            <li><a href="/servicios" class="hover:text-neutral/80 transition-colors">Servicios</a></li>
            <li aria-hidden="true" class="text-neutral/30">/</li>
            <li class="text-neutral/70">Certificación en Medellín</li>
          </ol>
        </nav>

        <div class="max-w-[800px]">
          <div class="flex items-center gap-3 mb-5">
            <span class="block w-8 h-px" style="background:#F97316;"></span>
            <span class="font-mono text-[11px] font-semibold tracking-[0.26em] uppercase" style="color:#F97316;">
              LujoGas · Certificación ICONTEC · Medellín
            </span>
          </div>

          <h1
            id="cert-medellin-heading"
            class="font-display font-semibold leading-[0.97] tracking-[-0.01em] text-background mb-5"
            style="font-size: clamp(36px,5vw,72px); max-width: 20ch;"
          >
            Certificación de gas en Medellín — ICONTEC, NTC 2505
          </h1>

          <p class="text-neutral/70 max-w-[62ch] mb-3" style="font-size: clamp(15px,1.3vw,17px); line-height: 1.65;">
            Expedición de certificado oficial de gas en Medellín requerido por Gas Natural EPM y Surtigas. Inspector certificado NTC 2505 con más de 3.000 certificaciones realizadas en el Valle de Aburrá.
          </p>
          <p class="text-neutral/60 max-w-[62ch] mb-8" style="font-size: clamp(13px,1.1vw,15px); line-height: 1.65;">
            Cobertura completa en Medellín y los municipios del área metropolitana. El certificado se entrega en 24 a 48 horas hábiles tras la inspección y aprobación.
          </p>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={waUrl}
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-semibold text-[15px] transition-all duration-200 hover:opacity-90 min-h-[48px]"
              style="background:#25D366; color:#fff;"
              aria-label="Solicitar certificación de gas en Medellín por WhatsApp"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              Solicitar certificación ahora
            </a>
            <a
              href="tel:+573014748653"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-semibold text-[15px] border transition-all duration-200 hover:border-neutral/40 min-h-[48px]"
              style="border-color: rgba(255,255,255,0.2); color: rgba(255,255,255,0.85);"
            >
              +57 301 474 8653
            </a>
          </div>
        </div>
      </div>

      <div
        class="absolute bottom-0 left-0 right-0 h-16 pointer-events-none"
        style="background: linear-gradient(to bottom, transparent, #F8F7F4);"
        aria-hidden="true"
      ></div>
    </section>

    <!-- ── Stats bar ─────────────────────────────────────────────────────── -->
    <section class="py-10" style="background:#F8F7F4;" aria-label="Estadísticas LujoGas">
      <div class="container-section">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10 reveal">
          {[
            { value: '3.000+', label: 'Certificaciones realizadas' },
            { value: '24–48h', label: 'Entrega del certificado' },
            { value: 'ICONTEC', label: 'Organismo acreditado' },
            { value: 'NTC 2505', label: 'Norma técnica colombiana' },
          ].map((stat) => (
            <div class="text-center">
              <p class="font-display font-bold text-primary leading-none mb-1" style="font-size: clamp(26px, 3.5vw, 44px);">
                {stat.value}
              </p>
              <p class="text-muted text-[13px] leading-snug">{stat.label}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Qué es la certificación ───────────────────────────────────────── -->
    <section class="section-pad bg-background" aria-labelledby="que-es-cert-heading">
      <div class="container-section">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
          <div class="reveal">
            <EyebrowLabel text="¿Qué es?" />
            <h2 id="que-es-cert-heading" class="font-display font-semibold text-primary mt-3 leading-tight mb-6" style="font-size:clamp(28px,3.5vw,46px);">
              ¿Qué es la certificación de gas ICONTEC en Medellín?
            </h2>
            <p class="text-muted text-[15px] leading-relaxed mb-4">
              La certificación de gas ICONTEC es el documento oficial que acredita que la instalación de gas de un inmueble cumple con la <a href="/blog/ntc-2505-norma-colombiana-instalaciones-gas" class="text-tertiary font-semibold underline underline-offset-4 hover:opacity-80">Norma Técnica Colombiana NTC 2505</a>. Es emitida por un inspector técnico acreditado y es requisito obligatorio de Gas Natural EPM y Surtigas para activar o mantener activo el servicio de gas domiciliario en Medellín y Antioquia.
            </p>
            <p class="text-muted text-[15px] leading-relaxed mb-4">
              Sin este certificado vigente, la distribuidora de gas puede negarse a activar el servicio en una instalación nueva, y puede suspender el servicio en instalaciones existentes cuando vence la RPO. La certificación también protege al propietario ante responsabilidades legales en caso de incidentes relacionados con la instalación de gas.
            </p>
            <p class="text-muted text-[15px] leading-relaxed mb-6">
              En LujoGas, el técnico Luis Guillermo Muñoz Vélez cuenta con certificación ICONTEC y aval de EPM / Gas Natural, con más de 3.000 certificaciones emitidas en el Valle de Aburrá. Si aún no sabes quién debe hacer la revisión, lee <a href="/blog/quien-certifica-gas-epm-o-tecnico-certificado" class="text-tertiary font-semibold underline underline-offset-4 hover:opacity-80">quién certifica el gas: EPM o un técnico</a>.
            </p>
            <a
              href={waUrl}
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-[14px] transition-all hover:opacity-90 min-h-[44px]"
              style="background:#25D366; color:#fff;"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              Solicitar certificación
            </a>
          </div>

          <!-- Cuándo es obligatoria -->
          <div class="reveal-stagger flex flex-col gap-5">
            <h3 class="font-display font-semibold text-primary text-[22px] leading-snug">¿Cuándo es obligatoria la certificación de gas?</h3>
            {cuandoObligatoria.map((caso) => (
              <div class="flex gap-4 p-5 bg-surface border border-neutral/15 rounded-2xl hover:border-tertiary/25 transition-colors">
                <div class="w-10 h-10 rounded-lg flex-shrink-0 flex items-center justify-center" style="background:rgba(249,115,22,0.10); color:#F97316;">
                  <span set:html={caso.icon} />
                </div>
                <div>
                  <p class="font-semibold text-primary text-[14.5px] mb-1">{caso.title}</p>
                  <p class="text-muted text-[13.5px] leading-relaxed">{caso.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ── Qué evalúa el técnico ─────────────────────────────────────────── -->
    <section class="section-pad" style="background:#F8F7F4;" aria-labelledby="evalua-heading">
      <div class="container-section">
        <div class="text-center mb-12 reveal">
          <EyebrowLabel text="Inspección técnica" />
          <h2 id="evalua-heading" class="font-display font-semibold text-primary mt-3 leading-tight" style="font-size:clamp(28px,3.5vw,44px);">
            Qué evalúa el técnico durante la certificación de gas
          </h2>
          <p class="text-muted mt-4 max-w-[52ch] mx-auto text-[15px] leading-relaxed">
            La inspección técnica verifica que la instalación cumpla todos los requisitos de la NTC 2505 antes de emitir el certificado.
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">
          {evaluaciones.map((ev) => (
            <div class="flex gap-4 p-5 bg-surface border border-neutral/15 rounded-2xl hover:border-secondary/25 transition-colors">
              <div class="w-8 h-8 rounded-lg flex-shrink-0 mt-0.5 flex items-center justify-center" style="background:rgba(37,99,235,0.08);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 12l2 2 4-4"/><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg>
              </div>
              <div>
                <p class="font-semibold text-primary text-[14px] mb-1 leading-snug">{ev.label}</p>
                <p class="text-muted text-[13px] leading-relaxed">{ev.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Proceso de certificación ──────────────────────────────────────── -->
    <section class="section-pad relative" style="background-color:#1A1A2E;" aria-labelledby="proceso-cert-heading">
      <div class="pipes-bg" aria-hidden="true"></div>
      <div class="container-section relative z-10">
        <div class="text-center mb-14 reveal">
          <EyebrowLabel text="Proceso de certificación" />
          <h2 id="proceso-cert-heading" class="font-display font-semibold text-background mt-3 leading-tight" style="font-size:clamp(28px,3.5vw,48px);">
            Cómo obtenemos tu certificado de gas en Medellín
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 reveal-stagger">
          {procesoCert.map((p) => (
            <div class="relative flex flex-col gap-4 p-6 rounded-2xl border border-neutral/10 bg-background/[0.03]">
              <span class="font-display text-[52px] font-bold leading-none" style="color:rgba(37,99,235,0.18);">{p.n}</span>
              <h3 class="font-display font-semibold text-background text-[18px] tracking-[0.02em] -mt-2">{p.title}</h3>
              <p class="text-neutral/55 text-[13.5px] leading-relaxed">{p.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Cobertura ───────────────────────────────────────────────────────── -->
    <section class="section-pad bg-background" aria-labelledby="cobertura-cert-heading">
      <div class="container-section">
        <div class="text-center mb-10 reveal">
          <EyebrowLabel text="Cobertura" />
          <h2 id="cobertura-cert-heading" class="font-display font-semibold text-primary mt-3 leading-tight" style="font-size:clamp(26px,3vw,42px);">
            Certificación de gas en todo el Valle de Aburrá
          </h2>
          <p class="text-muted mt-3 max-w-[50ch] mx-auto text-[15px]">
            Emitimos certificados ICONTEC en Medellín y todos los municipios del área metropolitana.
          </p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3 reveal-stagger">
          {zonas.map((z) => (
            <a
              href={`/instalacion-gas-${z.slug}`}
              class="group flex items-center justify-center gap-2 border border-neutral/15 rounded-xl px-4 py-3 text-[13.5px] font-semibold text-primary hover:border-tertiary/40 hover:bg-tertiary/5 transition-all duration-200 text-center min-h-[44px]"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#F97316" stroke-width="2" aria-hidden="true"><path d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
              Gas en {z.name}
            </a>
          ))}
        </div>
        <div class="mt-6 text-center reveal">
          <a href="/instalacion-gas-medellin" class="text-[14px] font-semibold underline underline-offset-2 hover:opacity-75 transition-opacity mr-6" style="color:#2563EB;">
            Ver instalación de gas en Medellín →
          </a>
          <a href="/mantenimiento-gas-medellin" class="text-[14px] font-semibold underline underline-offset-2 hover:opacity-75 transition-opacity" style="color:#F97316;">
            Ver mantenimiento y RPO →
          </a>
        </div>
      </div>
    </section>

    <!-- ── FAQ ─────────────────────────────────────────────────────────── -->
    <section class="section-pad" style="background:#F8F7F4;" aria-labelledby="faq-cert-heading">
      <div class="container-section">
        <div class="text-center mb-12 reveal">
          <EyebrowLabel text="Preguntas frecuentes" />
          <h2 id="faq-cert-heading" class="font-display font-semibold text-primary mt-3 leading-tight" style="font-size:clamp(28px,3.5vw,44px);">
            Preguntas sobre certificación de gas en Medellín
          </h2>
        </div>
        <div class="max-w-[720px] mx-auto flex flex-col gap-4 reveal-stagger">
          {faqSchema.mainEntity.map((faq) => (
            <details class="group border border-neutral/15 rounded-2xl overflow-hidden bg-surface">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer font-display font-semibold text-primary text-[16px] leading-snug list-none">
                {faq.name}
                <svg class="flex-shrink-0 transition-transform duration-200 group-open:rotate-180" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
              </summary>
              <div class="px-6 pb-5 text-muted text-[14.5px] leading-relaxed border-t border-neutral/10 pt-4">
                {faq.acceptedAnswer.text}
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <CTASection />
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  const io = new IntersectionObserver(
    (entries) => { entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => io.observe(el));
</script>
